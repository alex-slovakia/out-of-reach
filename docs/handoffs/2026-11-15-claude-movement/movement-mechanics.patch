+using System;
+using System.Reflection;
+using NUnit.Framework;
+using OutOfReach.Composition;
+using OutOfReach.Contracts;
+using OutOfReach.Player;
+using OutOfReach.Presentation.Hands;
+using UnityEngine;
+using UnityEngine.InputSystem;
+using UnityEngine.InputSystem.LowLevel;
+using Object = UnityEngine.Object;
+
+namespace OutOfReach.Tests.MovementIntegration
+{
+    /// <summary>
+    /// Actual capsule, solid colliders and Input System key edges. Fixture-only read views supply
+    /// phase/suit/pause policy; no simulated impulse or replacement locomotion. Art rigs are omitted:
+    /// hand tests prove surface selection/frame construction, not visible skin contact acceptance.
+    /// </summary>
+    public sealed class SurfacePushIntegrationTests
+    {
+        const BindingFlags Private = BindingFlags.Instance | BindingFlags.NonPublic;
+        GameObject root;
+        FirstPersonController player;
+        I06MicrogravityBridge bridge;
+        I06MicrogravityInputBindings input;
+        Transform eye;
+        Keyboard keyboard;
+        Mouse mouse;
+        ClockView clock;
+        bool contactAllowed, controlAllowed;
+        int pushCount;
+        float savedTimeScale;
+        InputSettings previousSettings, testSettings;
+        HideFlags previousSettingsFlags;
+
+        [SetUp]
+        public void SetUp()
+        {
+            savedTimeScale = Time.timeScale; Time.timeScale = 1f;
+            // Hidden native test runs have no focused Game View. Match the existing input tests:
+            // route synthetic devices through a temporary clone, never change the project asset.
+            previousSettings = InputSystem.settings; previousSettingsFlags = previousSettings.hideFlags;
+            testSettings = Object.Instantiate(previousSettings);
+            testSettings.hideFlags = HideFlags.HideAndDontSave;
+            testSettings.backgroundBehavior = InputSettings.BackgroundBehavior.IgnoreFocus;
+            testSettings.editorInputBehaviorInPlayMode = InputSettings.EditorInputBehaviorInPlayMode.AllDeviceInputAlwaysGoesToGameView;
+            previousSettings.hideFlags = HideFlags.None; // Preserve temporary defaults for exact restoration.
+            InputSystem.settings = testSettings;
+            keyboard = InputSystem.AddDevice<Keyboard>(); keyboard.MakeCurrent();
+            mouse = InputSystem.AddDevice<Mouse>(); mouse.MakeCurrent();
+            root = new GameObject("Surface push integration fixture");
+            var rig = new GameObject("Player"); rig.transform.SetParent(root.transform);
+            rig.transform.position = new Vector3(0f, 500.03f, 0f);
+            var capsule = rig.AddComponent<CharacterController>();
+            capsule.height = 1.8f; capsule.radius = .3f; capsule.center = Vector3.up * .9f;
+            capsule.skinWidth = .03f;
+            eye = new GameObject("Unbobbed eye").transform; eye.SetParent(rig.transform);
+            eye.localPosition = Vector3.up * 1.65f;
+            player = rig.AddComponent<FirstPersonController>(); player.Configure(eye, null);
+            player.SendMessage("OnApplicationFocus", true, SendMessageOptions.RequireReceiver);
+            Set(player, "captureCursor", false);
+            contactAllowed = controlAllowed = true;
+            player.ControlGate = () => controlAllowed;
+            player.Pushed += _ => pushCount++;
+            Box("Floor", new Vector3(0, 499.9f, 0), new Vector3(8, .2f, 8));
+            Physics.SyncTransforms();
+            Assert.That(player.EnterFloatFromFootSupport(), Is.EqualTo(FloatActionResult.Done));
+            bridge = root.AddComponent<I06MicrogravityBridge>();
+            var suit = new SuitView(); clock = new ClockView();
+            // Only the adapter/geometry seam is exercised; omitted art assets are never treated as contact proof.
+            Set(bridge, "bound", true); Set(bridge, "player", player); Set(bridge, "suit", suit);
+            input = root.AddComponent<I06MicrogravityInputBindings>();
+            input.Configure(player, bridge, eye, suit, new StateView(), clock, () => true, () => contactAllowed);
+            Assert.That(input.Arm(), Is.True, input.LastRefusal);
+            // The test drives input updates synchronously, after the arming boundary.
+            Set(input, "armedFrame", -1);
+            Keys();
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            if (input) input.ClearBinding();
+            if (root) Object.DestroyImmediate(root);
+            if (keyboard != null) InputSystem.RemoveDevice(keyboard);
+            if (mouse != null) InputSystem.RemoveDevice(mouse);
+            if (previousSettings)
+            {
+                InputSystem.settings = previousSettings;
+                previousSettings.hideFlags = previousSettingsFlags;
+            }
+            if (testSettings) Object.DestroyImmediate(testSettings);
+            Time.timeScale = savedTimeScale;
+            Cursor.lockState = CursorLockMode.None; Cursor.visible = true;
+        }
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public void WallAndCeiling_ProduceFiniteTangentFromLevelView(bool ceiling)
+        {
+            Vector3 direction = ceiling ? Vector3.up : Vector3.forward;
+            Collider surface = Box("Contact", eye.position + direction * .4f,
+                ceiling ? new Vector3(2, .1f, 2) : new Vector3(2, 2, .1f));
+            Physics.SyncTransforms();
+            Assert.That(surface.Raycast(new Ray(eye.position, direction), out RaycastHit hit, .8f), Is.True);
+            object[] args = { ContactHand.Left, HandContactKind.Push, hit, Vector3.zero, false, null };
+            Assert.That((bool)typeof(I06MicrogravityBridge).GetMethod("TryBuildContact", Private).Invoke(bridge, args),
+                Is.True, bridge.LastRefusal);
+            object contact = args[5];
+            var target = (HandContactTarget)contact.GetType().GetField("Target").GetValue(contact);
+            Vector3 tangent = surface.transform.TransformVector(target.LocalTangent);
+            Assert.That(tangent.magnitude, Is.EqualTo(1f).Within(.0001f));
+            Assert.That(Mathf.Abs(Vector3.Dot(tangent, hit.normal)), Is.LessThan(.0001f));
+            Assert.That(player.FloatVelocity, Is.EqualTo(Vector3.zero), "constructing a frame grants no impulse");
+        }
+
+        [Test]
+        public void SpaceFindsCeilingWithoutAimingAtIt_AndRejectsTriggerOnlySpace()
+        {
+            Collider ceiling = Box("Ceiling", eye.position + Vector3.up * .4f, new Vector3(2, .1f, 2));
+            Physics.SyncTransforms();
+            object[] args = { Vector3.zero };
+            Assert.That((bool)typeof(I06MicrogravityInputBindings).GetMethod("FindHandPushAim", Private).Invoke(input, args), Is.True);
+            Assert.That(Vector3.Dot((Vector3)args[0], Vector3.up), Is.GreaterThan(.999f));
+            ceiling.isTrigger = true; Physics.SyncTransforms();
+            args[0] = Vector3.zero;
+            Assert.That((bool)typeof(I06MicrogravityInputBindings).GetMethod("FindHandPushAim", Private).Invoke(input, args), Is.False);
+        }
+
+        [Test]
+        public void RepressSpaceDuringCooldown_IsBufferedOnce_HoldingDoesNotRepeat()
+        {
+            Keys(Key.Space);
+            Assert.That(pushCount, Is.EqualTo(1));
+            Assert.That(player.FloatVelocity.magnitude, Is.EqualTo(.65f).Within(.0001f));
+            player.ClearMotion(); Keys(); Keys(Key.Space);
+            Assert.That(pushCount, Is.EqualTo(1), "cooldown still belongs to Player");
+            AdvanceFloat(.36f); Tick();
+            Assert.That(pushCount, Is.EqualTo(2), "one buffered edge survives cooldown");
+            player.ClearMotion(); AdvanceFloat(.4f); Keys(Key.Space); Tick();
+            Assert.That(pushCount, Is.EqualTo(2), "held key must not manufacture another press");
+        }
+
+        [TestCase("pause")]
+        [TestCase("control")]
+        [TestCase("contact")]
+        public void DeniedPolicy_ClearsBufferedPressAndRequiresFreshRelease(string policy)
+        {
+            Keys(Key.Space); player.ClearMotion(); Keys(); Keys(Key.Space);
+            Assert.That(pushCount, Is.EqualTo(1));
+            Gate(policy, false); Tick();
+            Assert.That(player.FloatVelocity, Is.EqualTo(Vector3.zero));
+            Gate(policy, true); AdvanceFloat(.36f); Keys(Key.Space); Tick();
+            Assert.That(pushCount, Is.EqualTo(1), "resuming must not replay a queued or held press");
+            Keys(); Keys(Key.Space);
+            Assert.That(pushCount, Is.EqualTo(2), "a new press after release is valid");
+        }
+
+        [TestCase(Key.A, -1f)]
+        [TestCase(Key.D, 1f)]
+        public void SidewaysIntent_ChangesOnlyAContactPush(Key key, float sign)
+        {
+            Keys(key);
+            Assert.That(player.FloatVelocity, Is.EqualTo(Vector3.zero), "WASD alone supplies no hidden thrust");
+            Keys(key, Key.Space);
+            Assert.That(player.FloatVelocity.x * sign, Is.GreaterThan(.5f));
+            Assert.That(player.FloatVelocity.y, Is.GreaterThan(0f), "push must leave floor support");
+            Vector3 velocity = player.FloatVelocity;
+            Keys(key == Key.A ? Key.D : Key.A);
+            Assert.That(player.FloatVelocity, Is.EqualTo(velocity), "free drift keeps momentum");
+        }
+
+        [Test]
+        public void SpaceAwayFromAllSurfaces_RefusesWithoutImpulse()
+        {
+            // Fixture positioning via the real capsule, with no obstacles above the floor.
+            player.GetComponent<CharacterController>().Move(Vector3.up * 3f);
+            Physics.SyncTransforms();
+            Keys(Key.Space);
+            Assert.That(pushCount, Is.Zero);
+            Assert.That(player.FloatVelocity, Is.EqualTo(Vector3.zero));
+            Assert.That(input.LastFootResult, Is.EqualTo(FloatActionResult.NoSurface));
+            Assert.That(input.LastRefusal, Does.Contain("arm's reach"));
+        }
+
+        void Gate(string policy, bool allowed)
+        {
+            if (policy == "pause") clock.Paused = !allowed;
+            else if (policy == "control") controlAllowed = allowed;
+            else contactAllowed = allowed;
+        }
+        void Keys(params Key[] keys)
+        {
+            InputSystem.QueueStateEvent(keyboard, new KeyboardState(keys));
+            InputSystem.Update();
+            Assert.That(keyboard.spaceKey.isPressed, Is.EqualTo(Array.IndexOf(keys, Key.Space) >= 0),
+                "synthetic Space state must reach the device before testing dispatch");
+            Tick();
+        }
+        void Tick() => typeof(I06MicrogravityInputBindings).GetMethod("Update", Private).Invoke(input, null);
+        void AdvanceFloat(float seconds) => typeof(FirstPersonController).GetMethod("Float", Private).Invoke(player, new object[] { seconds });
+        static void Set(object target, string name, object value) => target.GetType().GetField(name, Private).SetValue(target, value);
+        Collider Box(string name, Vector3 position, Vector3 size)
+        {
+            var go = new GameObject(name); go.transform.SetParent(root.transform); go.transform.position = position;
+            var box = go.AddComponent<BoxCollider>(); box.size = size; return box;
+        }
+        sealed class ClockView : ISimulationClock
+        {
+            public bool Paused;
+            public bool IsPaused => Paused;
+            public double TimeScale => 1d;
+            public double ElapsedSimulationSeconds => 0d;
+        }
+        sealed class StateView : IGameState
+        {
+            public GamePhase Phase => GamePhase.Survival;
+            public MissionOutcome Outcome => MissionOutcome.None;
+            public double ElapsedSimulationSeconds => 0d;
+            public CommandResult TryTransition(GamePhase next) => throw new NotSupportedException();
+            public void AdvanceTime(double seconds) => throw new NotSupportedException();
+        }
+        sealed class SuitView : IEvaStatus
+        {
+            public bool IsSuitOn => true;
+            public bool IsSuitSealed => false;
+            public double SuitOxygenKg => 1d;
+            public double SuitOxygenCapacityKg => 1d;
+            public double SuitOxygenSecondsRemaining => 100d;
+            public bool IsOutside => false;
+            public AirlockState Airlock => AirlockState.InnerOpen;
+            public double AirlockTransitionRemainingSeconds => 0d;
+            public event Action Changed { add { } remove { } }
+        }
+    }
+}
