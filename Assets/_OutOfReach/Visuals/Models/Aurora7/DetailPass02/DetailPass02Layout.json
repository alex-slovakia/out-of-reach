{
 "package": "SHIP-DETAIL-02 (AURORA-7 interior detail pass), first bounded package plus CKP-REFINE",
 "coordinates": "AURORA-7 ship space: Unity metres, x right, y up (deck y = 0), z along the ship (cockpit at -z); drop each FBX at the ship origin with identity rotation and scale 1",
 "pivot_rule": "each object's pivot is the origin of its mount frame: a point on its host surface at deck level under the cluster; mount_normal points from the host into the room",
 "importer": "Bake Axis Conversion on, file units and scale, global scale 1, no cameras or lights; materials remapped by name onto the existing A7_*/HB_* material assets and the two CKP-REFINE materials DP02_PaintWorn and DP02_RubberKnurl in DetailPass02/Materials (see each FBX .meta)",
 "new_materials": {
  "DP02_PaintWorn": "Materials/DP02_PaintWorn.mat, URP Lit, Textures/DP02_PaintWorn_{BaseColor,MODS,Normal}.png (512 px, tiling 2 per metre), MODS = R metallic, G occlusion, A smoothness",
  "DP02_RubberKnurl": "Materials/DP02_RubberKnurl.mat, URP Lit, Textures/DP02_Knurl_{BaseColor,MODS,Normal}.png (512 px, tiling 16 per metre)"
 },
 "gameplay": "static dressing only: no colliders, no interactive parts, no new switches or anchors for gameplay; the *_ReviewEye empties mark the preview camera",
 "clearance_definitions": {
  "rails": "all A7_PaintAmber triangles of the ship and habitat (handrails/translation aids; also the amber hatch-land stripe, so the number is conservative)",
  "controls": "a7_ship switch_panel, display, gauge, breaker, console and seat geometry, the separately addressable gameplay parts, ship ANCHORS and the habitat anchors and colliders",
  "overlap": "BVHTree.overlap triangle pairs between each detail object and all ship and habitat geometry, both built in world space from matrix_world @ v.co",
  "mount_gap": "smallest distance from the object to any ship/habitat surface (seated, not floating)",
  "max_standoff": "largest distance from any vertex of the object to the nearest ship/habitat surface"
 },
 "cockpit_refine_clearance_definitions": {
  "rails": "amber handrails (A7_PaintAmber) of the ship and habitat plus the console's three rails rebuilt with a7_ship.handrail() (the check tags the console as a control), sampled on both surfaces at 3 mm: nearest refine point to a rail and nearest rail point to the refine mesh",
  "controls_note": "min_dist_controls_m is the operable-control distance; min_dist_host_console_or_seat_m is the distance to the host console/seat surfaces (the mount gap)",
  "corridor_note": "the generic corridor box (|x| < 0.9 from z -3) contains the console itself, so the console groups read 0 there; the cockpit's clear passage is cockpit_passage",
  "controls": "operable console parts as boxes from a7_ship.console(): keyboards, trackballs, knobs, the guarded switch rows, the lit key block, the red switch body, the visible screen and bezel keys of every display, both lit-key columns; plus the grab bar of each seat",
  "screens": "A7_Screens triangles (BVH nearest)",
  "volumes": "seat occupant boxes (x +-0.28 about each seat, y 0.17-1.60, z -1.00 to -0.245), the cockpit passage (|x| < 0.80 from the console handrail z -1.45 to the portal z 3.0, y < 2.5) and the portal opening at z 3 (1.8 x 2.5 m)",
  "anchors": "V01 anchors CockpitConsole (0, 1.1, -1.72) and PlayerSpawn (0, 0.05, 0.8)",
  "sampling": "refine surfaces sampled on a 3 mm grid; box distances are exact for each sample"
 },
