// LAUNCH-GRASS-V04 (15 Nov 2026, issue #11 R07). Original HLSL, written for OUT OF REACH.
// Tall golden pampas grass drawn with Graphics.RenderMeshPrimitives from one structured buffer
// (PampasGrassField), in three levels of detail per instance:
//   _Lod 0  the modeled clump (PampasClumpV04.fbx, PampasClump_LOD0): creased leaf blades, culm tubes and seed
//           heads modeled as a volume of feathery branch cards around the rachis;
//   _Lod 1  the simpler modeled clump (PampasClump_LOD1);
//   _Lod 2  two crossed cards with a whole clump, plus a horizontal cap that only opens when the camera looks
//           down on the field (vertical cards vanish from above).
// The model is generated by Tools~/make_pampas_models.py (Blender), the textures by
// Tools~/make_pampas_textures.py. Everything is original.
// Mesh data: uv0 texture coordinates, uv1 = (part, random), uv2.x = wind bend weight.
//   part: 0 leaf blade, .33 culm, .5 branch card (_TuftTex), .66 head core card (_PlumeTex), .9 cap, 1 card.
// Instance buffer: float4(world x, y, z, seed). Per draw: _ChunkStart, _ChunkCount, _Lod.
// Globals written by PampasGrassField / LaunchGrassGustPresenter:
//   _OOR_GrassWind      xy wind direction (world xz), z sway angle (rad), w gust-wave angle (rad)
//   _OOR_GrassWindWave  x wave speed (m/s), y wavelength (m), z reduced effects (0/1), w wind time (s)
//   _OOR_GrassLod       x detailed-model distance, y its cross-fade band, z max draw distance, w far count fraction
//   _OOR_GrassLod2      x model distance (cards beyond), y its cross-fade band
//   _OOR_GrassGust      xyz thruster gust origin (world), w strength 0..1 (0 = off)
//   _OOR_GrassGustWave  x shock front radius (m), y front width (m), z sustained reach (m), w flutter 0..1
//   _OOR_LaunchHaze     the grass's own aerial haze (0 while the depth fog pass does it for every surface)
Shader "OutOfReach/Launch Pampas Grass V04"
{
    Properties
    {
        [NoScaleOffset]_TuftTex("Feathery branch tufts atlas (4 x 1)",2D)="white"{}
        [NoScaleOffset]_PlumeTex("Seed heads atlas (4 x 1)",2D)="white"{}
        [NoScaleOffset]_ClumpTex("Whole clumps atlas (2 x 2)",2D)="white"{}
        [NoScaleOffset]_TopTex("Clumps from above atlas (2 x 2)",2D)="white"{}
        _AlbedoScale("Texture albedo scale",Range(0,1))=0.3
        _PlumeTint("Seed head tint",Color)=(1.0,0.97,0.90,1)
        _HeightRange("Clump height min, max (m)",Vector)=(1.05,2.35,0,0)
        _Olive("Leaf bases (olive)",Color)=(0.16,0.15,0.06,1)
        _Straw("Leaves and culms (straw)",Color)=(0.36,0.29,0.14,1)
        _Gold("Leaves and culms (golden amber)",Color)=(0.44,0.31,0.13,1)
        _Dry("Dry leaves (bleached straw)",Color)=(0.56,0.47,0.28,1)
        _OliveShare("Share of greener clumps",Range(0,1))=0.3
        _Translucency("Back-light through seed heads",Range(0,4))=0.75
        _RimGlow("Back-lit glow on wispy edges",Range(0,4))=1.4
        _TransTint("Back-light tint",Color)=(1.0,0.86,0.62,1)
        _FarCanopy("Canopy colour at the draw-distance edge (matches the ground shader)",Color)=(0.26,0.21,0.11,1)
        _Ambient("Ambient scale",Range(0,2))=0.9
        _GustSheen("Light/dark contrast of the rolling wind waves",Range(0,1))=0.5
        _HazeDensity("Own aerial haze per metre (no-depth fallback)",Float)=0.0012
        _HazeColor("Haze away from the sun",Color)=(0.62,0.58,0.52,1)
        _HazeSunColor("Haze towards the sun",Color)=(1.0,0.80,0.52,1)
        _HazeSunPower("Sun-ward haze sharpness",Float)=6
        _Cutoff("Alpha cutoff",Range(0.05,0.95))=0.4
    }
    SubShader
    {
        Tags {"RenderPipeline"="UniversalPipeline" "RenderType"="TransparentCutout" "Queue"="AlphaTest" "DisableBatching"="True"}
        Cull Off
        HLSLINCLUDE
        #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
        #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
        CBUFFER_START(UnityPerMaterial)
        float4 _HeightRange;
        half4 _PlumeTint, _Olive, _Straw, _Gold, _Dry, _TransTint, _HazeColor, _HazeSunColor, _FarCanopy;
        half _AlbedoScale, _OliveShare, _Translucency, _RimGlow, _Ambient, _GustSheen, _Cutoff;
        float _HazeDensity, _HazeSunPower;
        float _ChunkStart, _ChunkCount, _Lod;
        CBUFFER_END
        TEXTURE2D(_TuftTex); SAMPLER(sampler_TuftTex);
        TEXTURE2D(_PlumeTex); SAMPLER(sampler_PlumeTex);
        TEXTURE2D(_ClumpTex); SAMPLER(sampler_ClumpTex);
        TEXTURE2D(_TopTex); SAMPLER(sampler_TopTex);
        StructuredBuffer<float4> _OOR_GrassInstances;
        float4 _OOR_GrassWind, _OOR_GrassWindWave, _OOR_GrassLod, _OOR_GrassLod2, _OOR_GrassGust, _OOR_GrassGustWave;
        float _OOR_LaunchHaze;

        struct Attributes
        {
            float3 positionOS:POSITION; float3 normalOS:NORMAL;
            float2 uv:TEXCOORD0; float2 attr:TEXCOORD1; float2 bend:TEXCOORD2;
            uint instanceID:SV_InstanceID;
        };
        struct Varyings
        {
            float4 positionCS:SV_POSITION;
            float3 positionWS:TEXCOORD0;
            float3 normalWS:TEXCOORD1;
            float4 uvPart:TEXCOORD2;   // uv, part id, per-part random
            float4 shade:TEXCOORD3;    // height along the clump, instance seed, wind wave, unused
            float2 fog:TEXCOORD4;      // scene fog factor, front-light (sun behind the camera)
            float4 tint:TEXCOORD5;     // per-instance relative tint, greener-clump flag
            float4 light:TEXCOORD6;    // back-light, own haze amount, sun-ward haze, far blend
            float4 ambient:TEXCOORD7;  // ambient light, straw/gold mix
            float2 lodRange:TEXCOORD8; // this level draws the instance where lodRange.x <= dither < lodRange.y
        };

        float Hash11(float p){p=frac(p*.1031);p*=p+33.33;p*=p+p;return frac(p);}
        float Hash21(float2 p){p=frac(p*float2(.1031,.11369));p+=dot(p,p.yx+19.19);return frac((p.x+p.y)*p.x);}
        float Noise(float2 p)
        {
            float2 c=floor(p),f=frac(p);f=f*f*(3-2*f);
            return lerp(lerp(Hash21(c),Hash21(c+float2(1,0)),f.x),lerp(Hash21(c+float2(0,1)),Hash21(c+1),f.x),f.y);
        }

        // Fraction of instances kept beyond the modeled range (cards thin out with distance).
        float KeepFraction(float d)
        {
            float t=saturate((d-_OOR_GrassLod2.x)/max(_OOR_GrassLod.z-_OOR_GrassLod2.x,1));
            float e=1-t;
            return lerp(1,_OOR_GrassLod.w,1-e*e);
        }

        Varyings GrassVertex(Attributes v)
        {
            Varyings o=(Varyings)0;
            uint index=(uint)_ChunkStart+v.instanceID;
            float4 inst=_OOR_GrassInstances[index];
            float3 root=inst.xyz; float seed=inst.w;
            float r1=Hash11(seed*91.7+1.3), r2=Hash11(seed*53.1+7.7), r3=Hash11(seed*17.3+3.1);
            float d=length(root-_WorldSpaceCameraPos);
            float card=step(1.5,_Lod);

            // Level-of-detail hand-over: each level draws an instance inside its own window of the dither value.
            float w0=smoothstep(_OOR_GrassLod.x-_OOR_GrassLod.y,_OOR_GrassLod.x+_OOR_GrassLod.y,d);
            float w1=smoothstep(_OOR_GrassLod2.x-_OOR_GrassLod2.y,_OOR_GrassLod2.x+_OOR_GrassLod2.y,d);
            o.lodRange=_Lod<.5?float2(w0,2):(_Lod<1.5?float2(w1,w0):float2(-1,w1));

            // Count thinning with distance: instance rank inside its shuffled chunk vs. the kept fraction.
            float rank=(v.instanceID+.5)/max(_ChunkCount,1);
            float keep=KeepFraction(d)*(_OOR_GrassWindWave.z>.5?.55:1);
            float visible=saturate((keep-rank)/.06);
            float widen=clamp(rsqrt(max(keep,.05)),1,2.4);
            float fade=1-smoothstep(_OOR_GrassLod.z*.82,_OOR_GrassLod.z,d);

            // Height: broad swathes and hollows, per-instance variation and a few tall emergent clumps.
            float patch=Noise(root.xz/52+17)*.6+Noise(root.xz/15+3)*.4;
            float H=lerp(_HeightRange.x,_HeightRange.y,saturate(r1*.4+patch*1.05-.3));
            H*=r3>.88?1.22:1;
            float yaw=r2*6.2831853;
            float s,c; sincos(yaw,s,c);
            float3 p=v.positionOS;
            // Every clump leans a little its own way, so the same model never repeats exactly.
            p.xz+=(float2(Hash11(seed*5.3+.7),Hash11(seed*9.1+.2))-.5)*.2*p.y*(1-card);
            p=float3(p.x*c-p.z*s,p.y,p.x*s+p.z*c);
            float3 n=float3(v.normalOS.x*c-v.normalOS.z*s,v.normalOS.y,v.normalOS.x*s+v.normalOS.z*c);
            float width=(card>.5?widen:1)*lerp(.9,1.15,r3);
            if(card>.5 && v.attr.x<.95)
            {
                float3 toCap=root+float3(0,H*.55,0)-_WorldSpaceCameraPos;
                width*=smoothstep(.09,.3,abs(toCap.y)/max(length(toCap),1e-3))*smoothstep(.15,1,w1);
            }
            p.xz*=H*width; p.y*=H*fade*visible;
            float hNorm=saturate(v.positionOS.y);

            // Wind: slow sway plus broad gust bands travelling along the wind direction.
            float2 wd=normalize(_OOR_GrassWind.xy+1e-5);
            float along=dot(root.xz,wd), across=dot(root.xz,float2(-wd.y,wd.x));
            float t=_OOR_GrassWindWave.w;
            float reduced=_OOR_GrassWindWave.z;
            float wl=max(_OOR_GrassWindWave.y,1);
            float wave=Noise(float2((along-t*_OOR_GrassWindWave.x)/wl,across/(wl*2.6)))*.75
                      +Noise(float2((along-t*_OOR_GrassWindWave.x*1.3)/(wl*.37),across/(wl*.9)+5))*.25;
            wave=smoothstep(.36,.86,wave);
            float sway=sin(t*1.6+r1*6.28+along*.21)*.5+.5;
            float flick=sin(t*4.3+r3*40+hNorm*2)*.5;
            float windAngle=_OOR_GrassWind.z*(.45+.55*sway)+_OOR_GrassWind.w*wave*(reduced>.5?.4:1);
            float2 bendVec=wd*windAngle+float2(-wd.y,wd.x)*flick*_OOR_GrassWind.z*.35*(1-reduced);

            // Thruster gust: radial shock front plus a sustained push near the pad, flattening the grass outwards.
            if(_OOR_GrassGust.w>1e-4)
            {
                float2 rel=root.xz-_OOR_GrassGust.xz; float dist=length(rel)+1e-3; float2 rdir=rel/dist;
                float frontW=max(_OOR_GrassGustWave.y,1);
                float q=(dist-_OOR_GrassGustWave.x)/frontW; float front=exp(-q*q);
                float inside=pow(saturate(1-dist/max(_OOR_GrassGustWave.z,1)),.7)*saturate((_OOR_GrassGustWave.x-dist)/frontW+1);
                float push=_OOR_GrassGust.w*(front*1.1+inside*.75);
                float shiver=sin(t*23+r3*60+dist*.7)*_OOR_GrassGustWave.w*push*(1-reduced);
                bendVec+=rdir*(push*1.25+shiver*.22);
                wave=max(wave,push*1.6);
            }
            float angle=min(length(bendVec),1.35);
            float2 bendDir=bendVec/max(length(bendVec),1e-4);
            float a=angle*pow(hNorm,1.6)*v.bend.x;
            float sa,ca; sincos(a,sa,ca);
            float lift=p.y;
            p.y=lift*ca;
            p.xz+=bendDir*lift*sa;

            float3 posWS=root+p;
            o.positionWS=posWS;
            o.positionCS=TransformWorldToHClip(posWS);
            o.normalWS=normalize(n+float3(bendDir.x,0,bendDir.y)*sa*.5);
            o.uvPart=float4(v.uv,v.attr.x,v.attr.y);
            o.shade=float4(hNorm,seed,wave,0);
            o.fog.x=ComputeFogFactor(o.positionCS.z);
            // Per-instance colour and view/sun terms once per vertex: the far cards overdraw heavily.
            float patchN=Noise(root.xz/31+5.3);
            float mixv=saturate(Hash11(seed*3.7)*.7+patchN*.5);
            float olive=step(Hash11(seed*7.1+.3),_OliveShare*(.6+.8*patchN));
            o.tint=float4(lerp(float3(.90,.93,.93),float3(1.12,1.0,.82),mixv)*lerp(.84,1.1,patchN),olive);
            float dv=length(posWS-_WorldSpaceCameraPos);
            float toSun=dot((posWS-_WorldSpaceCameraPos)/max(dv,1e-3),_MainLightPosition.xyz);
            o.fog.y=pow(saturate(.5-toSun*.5),2);
            o.light=float4(pow(saturate(toSun*.5+.5),4),(1-exp(-dv*_HazeDensity))*saturate(_OOR_LaunchHaze),
                pow(saturate(toSun*.5+.5),_HazeSunPower),smoothstep(_OOR_GrassLod.z*.35,_OOR_GrassLod.z,dv));
            o.ambient=float4(SampleSH(float3(0,1,0))*_Ambient,mixv);
            return o;
        }

        float IGN(float2 pixel){return frac(52.9829189*frac(dot(pixel,float2(.06711056,.00583715))));}

        // Card atlas lookup: one of 4 whole clumps per instance and quad.
        float2 ClumpUV(Varyings i)
        {
            float rnd=i.uvPart.w; float seed=i.shade.y; float2 uv=i.uvPart.xy;
            float variant=floor(frac(seed*7.3+rnd*3.1)*3.999);
            if(frac(seed*29.7+rnd)>.5) uv.x=1-uv.x;
            return (float2(fmod(variant,2),floor(variant*.5))+uv)*.5;
        }

        bool Hidden(Varyings i,float dither){return dither<i.lodRange.x || dither>=i.lodRange.y;}

        // rgb = albedo, a = coverage. `head` = how much of this texel is a seed head (pale, thin, translucent).
        half4 Surface(Varyings i,float2 pixel,out half head)
        {
            float dither=IGN(pixel);
            float seed=i.shade.y, h=i.shade.x, part=i.uvPart.z, rnd=i.uvPart.w;
            half4 s;
            if(_Lod<1.5)
            {
                if(part>.42)
                {
                    // Seed head: core cards and the feathery branch cards around the rachis.
                    half4 t;
                    if(part>.58) t=SAMPLE_TEXTURE2D(_PlumeTex,sampler_PlumeTex,i.uvPart.xy);
                    else t=SAMPLE_TEXTURE2D(_TuftTex,sampler_TuftTex,i.uvPart.xy);
                    // Inner parts of the head are shaded by the outer ones: branch cards darken towards the rachis.
                    float depth=part>.58?.82:lerp(.7,1.06,smoothstep(0,.8,i.uvPart.y));
                    s=half4(t.rgb*_PlumeTint.rgb*i.tint.rgb*_AlbedoScale*lerp(.86,1.1,rnd)*depth,t.a);
                    head=1;
                }
                else
                {
                    // Leaf blades (olive, self-shadowed bases, straw towards the tips, some dry) and culms.
                    half3 stem=lerp(_Straw.rgb,_Gold.rgb,i.ambient.w);
                    half3 col;
                    if(part>.2) col=lerp(stem*1.15,_Dry.rgb,.35+.3*rnd);
                    else
                    {
                        float along=i.uvPart.y;
                        col=lerp(_Olive.rgb*lerp(1,1.5,i.tint.a),stem,smoothstep(.05,.75,along)*lerp(.75,1,rnd));
                        col=lerp(col,_Dry.rgb,max(step(.85,rnd)*.85,smoothstep(.8,1,along)*.5));
                        col*=.86+.28*abs(i.uvPart.x-.5);                     // lighter edges, darker midrib
                    }
                    s=half4(col*lerp(.42,1,smoothstep(0,.35,h)),1);
                    head=0;
                }
                if(Hidden(i,dither)) s.a=0;
            }
            else
            {
                bool cap=part<.95;
                half4 t;
                if(cap) t=SAMPLE_TEXTURE2D(_TopTex,sampler_TopTex,ClumpUV(i));
                else t=SAMPLE_TEXTURE2D(_ClumpTex,sampler_ClumpTex,ClumpUV(i));
                head=smoothstep(.62,.8,t.g);                                  // cream heads vs. olive and straw foliage
                half3 foliage=t.rgb*lerp(half3(1,1,1),half3(.74,.86,.58),i.tint.a*.6);
                half3 col=lerp(foliage,t.rgb*_PlumeTint.rgb,head)*i.tint.rgb*_AlbedoScale;
                // Self-shadowed base, relaxed with distance so the far field is not speckled.
                s=half4(col*(cap?lerp(.7,1,head):lerp(lerp(.5,.8,i.light.w),1,smoothstep(0,.3,i.uvPart.y))),t.a);
                if(!cap && Hidden(i,dither)) s.a=0;                           // caps grow in instead of dithering
            }
            s.rgb*=lerp(1-_GustSheen*.45,1+_GustSheen*.9,i.shade.z);          // wind waves: bright crests, dark troughs
            s.rgb=lerp(s.rgb,_FarCanopy.rgb,i.light.w*.3);
            return s;
        }

        // Coverage only (depth passes).
        float Coverage(Varyings i,float2 pixel)
        {
            float dither=IGN(pixel);
            float part=i.uvPart.z;
            float a=1;
            if(_Lod<1.5)
            {
                if(part>.58) a=SAMPLE_TEXTURE2D(_PlumeTex,sampler_PlumeTex,i.uvPart.xy).a;
                else if(part>.42) a=SAMPLE_TEXTURE2D(_TuftTex,sampler_TuftTex,i.uvPart.xy).a;
                if(Hidden(i,dither)) a=0;
            }
            else
            {
                bool cap=part<.95;
                if(cap) a=SAMPLE_TEXTURE2D(_TopTex,sampler_TopTex,ClumpUV(i)).a;
                else a=SAMPLE_TEXTURE2D(_ClumpTex,sampler_ClumpTex,ClumpUV(i)).a;
                if(!cap && Hidden(i,dither)) a=0;
            }
            return a;
        }
        ENDHLSL

        Pass
        {
            Name "UniversalForward"
            Tags {"LightMode"="UniversalForward"}
            ZWrite On
            HLSLPROGRAM
            #pragma target 4.5
            #pragma vertex GrassVertex
            #pragma fragment GrassFragment
            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE
            #pragma multi_compile_fragment _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH
            #pragma multi_compile_fog

            half4 GrassFragment(Varyings i, bool front:SV_IsFrontFace):SV_Target
            {
                half head;
                half4 s=Surface(i,i.positionCS.xy,head);
                clip(s.a-_Cutoff);
                float card=step(1.5,_Lod);
                float part=i.uvPart.z;
                float3 N=normalize(i.normalWS);
                // Only the blades are two-sided surfaces. Culm tubes and head cards carry volume normals (radiating
                // from the rachis), so a head shades as one soft form; cards shade as a canopy.
                if(card<.5 && part<.2) N*=front?1:-1;
                N=normalize(lerp(N,float3(0,1,0),card>.5?.92:(head>.5?.3:.4)));
                Light light=GetMainLight();
                float shadow=1;
                if(card<.5) shadow=MainLightRealtimeShadow(TransformWorldToShadowCoord(i.positionWS));
                float ndl=saturate(dot(N,light.direction)*.6+.4);
                float volume=lerp(.5,1,saturate(dot(N,light.direction)*.5+.5));   // fluffy: never black on the far side
                ndl=lerp(ndl,max(volume,.55+.45*i.fog.y),head);
                float thin=card>.5?lerp(.5,1,head):(head>.5?1:(part>.2?.35:.55));
                float back=i.light.x;
                float rim=0;
                if(card<.5 && part<.2) rim=pow(1-saturate(abs(dot(N,normalize(_WorldSpaceCameraPos-i.positionWS)))),3)*.35;
                // Wispy edges (low coverage) transmit the most light: a glowing rim when the sun is behind them.
                float edge=saturate((1-s.a)*2.4)*head;
                float h=i.shade.x;
                half3 ambient=i.ambient.rgb*lerp(.45,1,h);
                half3 color=s.rgb*(light.color*ndl*shadow+ambient);
                color+=s.rgb*_TransTint.rgb*light.color*(back*(_Translucency+edge*_RimGlow)+rim*back)*thin*lerp(.3,1,shadow)
                    *smoothstep(.1,.6,h)*(1-.7*i.light.w);

                // Own aerial haze (only when the depth fog pass is unavailable), then scene fog.
                half3 hazeColor=lerp(_HazeColor.rgb,_HazeSunColor.rgb,i.light.z)*max(light.color,.35);
                color=lerp(color,hazeColor,i.light.y);
                color=MixFog(color,i.fog.x);
                return half4(color,1);
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthOnly"
            Tags {"LightMode"="DepthOnly"}
            ZWrite On ColorMask R
            HLSLPROGRAM
            #pragma target 4.5
            #pragma vertex GrassVertex
            #pragma fragment DepthFragment
            half4 DepthFragment(Varyings i):SV_Target
            {
                clip(Coverage(i,i.positionCS.xy)-_Cutoff);
                return i.positionCS.z;
            }
            ENDHLSL
        }

        Pass
        {
            Name "DepthNormals"
            Tags {"LightMode"="DepthNormals"}
            ZWrite On
            HLSLPROGRAM
            #pragma target 4.5
            #pragma vertex GrassVertex
            #pragma fragment DepthNormalsFragment
            half4 DepthNormalsFragment(Varyings i, bool front:SV_IsFrontFace):SV_Target
            {
                clip(Coverage(i,i.positionCS.xy)-_Cutoff);
                float3 N=normalize(lerp(normalize(i.normalWS),float3(0,1,0),.45));
                return half4(N,0);
            }
            ENDHLSL
        }
    }
    FallBack Off
}
