.reference-orbits { flex-shrink: 0; padding: 14px 0; margin-bottom: 12px; color: #d8dfdb; }
.reference-orbits-title { font-size: 22px; margin-bottom: 5px; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/SourceSans3-Semibold.otf"); }
.reference-orbits-note { font-size: 13px; white-space: normal; color: #aab9b4; margin-top: 4px; }
.reference-orbits-controls { flex-direction: row; flex-wrap: wrap; margin-top: 10px; margin-bottom: 5px; }
.reference-orbits-button { font-size: 14px; min-height: 30px; padding: 3px 10px; margin: 0 6px 5px 0; border-width: 1px; border-color: #465651; border-radius: 0; background-color: #18201e; color: #e3e9e4; }
.reference-orbits-button:hover, .reference-orbits-button:focus { border-color: #ceb581; background-color: #27332e; }
.reference-orbits-button.orbit-body-0 { color: #ffc259; }
.reference-orbits-button.orbit-body-1 { color: #69bfe3; }
.reference-orbits-button.orbit-body-2 { color: #db7047; }
.reference-orbits-toggle { font-size: 13px; margin: 0 0 7px 0; }
.reference-orbits-canvas { height: 220px; min-height: 220px; flex-shrink: 0; overflow: hidden; background-color: #070c0e; border-width: 1px; border-color: #2c3937; }
.reference-orbits-canvas:focus { border-color: #ceb581; }
.reference-orbits-scale { font-size: 13px; color: #e1d6b8; margin-top: 7px; white-space: normal; }

.reference-orbits-details { font-size: 13px; color: #b9c5bf; margin-top: 8px; }

.reference-orbits-compact { padding: 0; margin: 0; }
.reference-orbits-compact .reference-orbits-title, .reference-orbits-compact .reference-orbits-note, .reference-orbits-compact .reference-orbits-controls, .reference-orbits-compact .reference-orbits-toggle, .reference-orbits-compact .reference-orbits-scale, .reference-orbits-compact .reference-orbits-details { display: none; }
.reference-orbits-compact .reference-orbits-canvas { height: 180px; min-height: 180px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.reference-orbits-explore { align-self: flex-end; border-width: 0; background-color: rgba(0, 0, 0, 0); color: #d7b77b; margin: 0; min-height: 22px; padding: 0; font-size: 13px; }
.reference-orbits-preview-caption { font-size: 11px; color: #9caba5; white-space: normal; }
