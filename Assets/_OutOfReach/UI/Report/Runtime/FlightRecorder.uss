.flight-recorder {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    padding: 46px 80px 36px 80px;
    background-color: rgba(0, 0, 0, 0);
    color: #eee8dc;
    -unity-font-definition: initial;
    -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/SourceSans3-Regular.otf");
    font-size: 20px;
    border-width: 0;
}
.recorder-hidden { display: none; }
.recorder-end-card { flex-grow: 1; min-height: 0; align-items: stretch; justify-content: space-between; opacity: 1; translate: 0 0; transition-property: opacity, translate; transition-duration: 0.7s; transition-timing-function: ease-out; }
.recorder-end-card.recorder-entering { opacity: 0; translate: 0 12px; }
.recorder-end-masthead { flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0; min-height: 28px; }
.recorder-brand { font-size: 14px; letter-spacing: 3px; color: #e2e3dc; }
.recorder-vessel { font-size: 11px; letter-spacing: 1.6px; color: #9da8a6; }
.recorder-end-hero { flex-grow: 1; min-height: 0; justify-content: center; align-items: center; padding-top: 20px; padding-bottom: 20px; }
.recorder-end-eyebrow { font-size: 12px; letter-spacing: 2.5px; color: #d6b57a; border-left-width: 18px; border-left-color: #cfa968; padding-left: 12px; margin-bottom: 18px; }
.recorder-end-headline { font-size: 180px; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); letter-spacing: 3px; white-space: normal; -unity-text-align: middle-center; margin: 0 0 12px 0; }
.recorder-end-summary { max-width: 640px; font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 34px; color: #c6c5c0; }
.recorder-end-actions { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; }
.recorder-end-actions .recorder-button { -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); background-color: rgba(0, 0, 0, 0); color: #aab4b2; border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); border-radius: 0; font-size: 27px; margin: 4px 6px; padding: 8px 12px; min-height: 42px; -unity-text-align: middle-center; transition-duration: 0.16s; }
.recorder-end-actions .recorder-primary-action { color: #eceee8; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-end-actions .recorder-button:hover, .recorder-end-actions .recorder-button:focus { background-color: rgba(0, 0, 0, 0); color: #edcb8e; border-width: 0; border-bottom-width: 2px; border-bottom-color: #d6b57a; }
.recorder-end-actions .recorder-button:active { color: #ffffff; }
.recorder-end-elapsed { font-size: 11px; color: #8b9997; letter-spacing: 1.4px; white-space: normal; border-top-width: 1px; border-top-color: rgba(165, 181, 176, 0.16); padding-top: 16px; }
.recorder-reduced .recorder-end-card, .recorder-reduced .recorder-end-actions .recorder-button { transition-duration: 0s; translate: 0 0; scale: 1 1; }
.recorder-lost { background-color: rgba(7, 8, 10, 0.58); }
.recorder-lost .recorder-end-hero { max-width: none; align-items: center; }
.recorder-lost .recorder-end-eyebrow { display: none; }
.recorder-lost .recorder-end-headline { color: #d85045; font-size: 180px; letter-spacing: 3px; -unity-text-align: middle-center; margin: 0 0 12px 0; white-space: nowrap; }
.recorder-lost .recorder-end-summary { max-width: 640px; font-size: 20px; -unity-text-align: middle-center; color: #c6c5c0; margin-bottom: 34px; }
.recorder-lost .recorder-end-actions { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; }
.recorder-lost .recorder-end-actions .recorder-button { margin: 4px 6px; padding: 8px 12px; border-left-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); font-size: 27px; -unity-text-align: middle-center; transform-origin: center; }
.recorder-lost .recorder-end-actions .recorder-primary-action { color: #eee8dc; font-size: 27px; }
.recorder-lost .recorder-end-actions .recorder-button:hover, .recorder-lost .recorder-end-actions .recorder-button:focus { color: #fff0e9; border-left-width: 0; border-bottom-color: #d85045; translate: 0 0; scale: 1 1; }
.recorder-lost .recorder-end-elapsed { -unity-text-align: middle-center; }
.recorder-recovery .recorder-end-headline { color: #e9eee4; }
.recorder-recovery { background-color: rgba(7, 8, 10, 0.38); }
.recorder-detail { flex-grow: 1; min-height: 0; min-width: 0; padding: 16px 22px; background-color: rgba(15, 19, 20, 0.92); border-width: 1px; border-color: #48504f; }
.recorder-detail-navigation { flex-direction: row; align-items: center; flex-shrink: 0; padding-bottom: 10px; }
.recorder-detail-title { font-size: 20px; color: #d5d7ce; margin-left: 12px; }
.recorder-roll-controls { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #48504f; }
.recorder-roll-caption { flex-grow: 1; font-size: 11px; letter-spacing: 1px; color: #b6bcb9; margin-right: 16px; white-space: normal; }
.recorder-roll-controls .recorder-button { font-size: 15px; min-height: 36px; padding: 6px 10px; }
.recorder-linked-value { flex-grow: 1; flex-basis: 0; min-width: 0; }
.recorder-linked-value .recorder-value { flex-basis: auto; }
.recorder-source-link { align-self: flex-start; background-color: rgba(0, 0, 0, 0); color: #d7be85; border-width: 0; border-bottom-width: 1px; border-bottom-color: #8c7b54; border-radius: 0; padding: 8px 0; margin: 4px 0; font-size: 16px; white-space: normal; }
.recorder-source-link:hover, .recorder-source-link:focus { color: #fff0ce; border-bottom-color: #efd19a; }
.recorder-masthead {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #606869;
}
.recorder-identifier {
    flex-grow: 1;
    font-size: 16px;
    color: #b6bcb9;
    margin-right: 16px;
    white-space: normal;
}
.recorder-status { font-size: 16px; color: #d7be85; white-space: normal; }
.recorder-lost .recorder-status { color: #ffb1a4; }
.recorder-recovery .recorder-status { color: #b2d0c8; }
.recorder-scroll { flex-grow: 1; min-height: 0; min-width: 0; }
.recorder-scroll .unity-scroll-view__content-container { padding-right: 12px; }
.recorder-summary { padding-top: 22px; padding-bottom: 24px; flex-shrink: 0; }
.recorder-headline {
    font-size: 32px;
    -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/SourceSans3-Semibold.otf");
    white-space: normal;
    margin-bottom: 8px;
}
.recorder-reason { white-space: normal; margin-bottom: 8px; }
.recorder-context { color: #b6bcb9; font-size: 18px; white-space: normal; }
.recorder-elapsed { color: #d7be85; font-size: 17px; white-space: normal; margin-top: 16px; }
.recorder-section {
    flex-shrink: 0;
    padding-top: 16px;
    padding-bottom: 20px;
    border-top-width: 1px;
    border-top-color: #4b5354;
}
.recorder-section:focus { border-top-color: #d7be85; }
.recorder-section-heading { flex-direction: row; margin-bottom: 10px; }
.recorder-number { color: #a3adaa; width: 34px; flex-shrink: 0; font-size: 17px; padding-top: 3px; }
.recorder-section-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: 23px;
    -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/SourceSans3-Semibold.otf");
}
.recorder-classification { color: #d7be85; font-size: 15px; white-space: normal; margin-bottom: 6px; }
.recorder-fact { flex-direction: row; padding-top: 5px; padding-bottom: 5px; flex-shrink: 0; }
.recorder-label { flex-basis: 32%; flex-shrink: 1; min-width: 0; margin-right: 20px; white-space: normal; color: #b6bcb9; }
.recorder-value { flex-grow: 1; flex-basis: 0; min-width: 0; white-space: normal; }
.recorder-empty { color: #b6bcb9; white-space: normal; margin-top: 8px; margin-bottom: 16px; }
.recorder-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: #606869;
}
.recorder-navigation { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.recorder-button {
    background-color: #20282a;
    color: #eee8dc;
    border-width: 1px;
    border-color: #626c6b;
    border-radius: 2px;
    margin: 2px 8px 2px 0;
    padding: 8px 12px;
    min-height: 44px;
    white-space: normal;
    font-size: 18px;
}
.recorder-button:hover { background-color: #313d3f; }
.recorder-button:focus { border-color: #efd19a; border-width: 2px; }
.recorder-button:active { background-color: #465052; }
.recorder-button:disabled { opacity: 0.45; }
.recorder-restart { border-color: #b6a276; color: #f1d9a9; }
.recorder-compact { padding: 24px 28px; }
.recorder-compact .recorder-vessel { display: none; }
.recorder-compact .recorder-end-hero { padding-top: 12px; padding-bottom: 12px; }
.recorder-compact .recorder-end-headline { font-size: 36px; }
.recorder-compact .recorder-end-summary { font-size: 17px; }
.recorder-compact .recorder-end-actions { flex-direction: row; align-items: center; }
.recorder-compact .recorder-detail { padding: 10px 12px; }
.recorder-compact .recorder-headline { font-size: 26px; }
.recorder-compact .recorder-fact { flex-direction: column; }
.recorder-compact .recorder-label { flex-basis: auto; margin-right: 0; margin-bottom: 2px; font-size: 17px; }
.recorder-compact .recorder-value { flex-basis: auto; }
.recorder-compact .recorder-linked-value { flex-basis: auto; }
.recorder-lost.recorder-loss-compact .recorder-end-headline { font-size: 120px; letter-spacing: 3px; }
.recorder-lost.recorder-loss-compact .recorder-end-summary { font-size: 18px; margin-bottom: 22px; }
.recorder-lost.recorder-compact .recorder-end-headline { font-size: 72px; letter-spacing: 2px; }
.recorder-lost.recorder-compact .recorder-end-actions { flex-direction: row; align-items: center; }
.recorder-loss-compact .recorder-end-headline { font-size: 120px; letter-spacing: 3px; }
.recorder-compact .recorder-end-card .recorder-end-headline { font-size: 72px; letter-spacing: 2px; }
.recorder-source-layout { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; }
.recorder-source-navigation { width: 235px; flex-shrink: 0; margin-right: 42px; }
.recorder-source-title { font-size: 50px; letter-spacing: 2px; margin-bottom: 36px; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-source-tab { -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); background-color: rgba(0, 0, 0, 0); border-width: 0; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-radius: 0; margin: 0 0 14px 0; padding: 9px 12px; min-height: 44px; font-size: 21px; letter-spacing: 1px; -unity-text-align: middle-left; }
.recorder-source-tab:hover, .recorder-source-tab:focus { background-color: rgba(255, 255, 255, 0.04); border-width: 0; border-left-width: 2px; border-left-color: #efd19a; }
.recorder-source-tab.recorder-source-selected { color: #edbc72; border-left-color: #edbc72; }
.recorder-source-page { min-width: 0; flex-shrink: 0; padding: 12px 0 32px 0; }
.recorder-source-heading { font-size: 38px; letter-spacing: 1px; white-space: normal; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); margin-bottom: 8px; }
.recorder-source-deck { font-size: 25px; color: #c5c6c2; white-space: normal; margin-bottom: 24px; }
.recorder-source-description { font-size: 21px; white-space: normal; margin-bottom: 20px; max-width: 720px; }
.recorder-source-note { color: #aeb5b2; font-size: 17px; white-space: normal; margin-top: 24px; }
.recorder-source-page .recorder-source-link { background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 1px; border-bottom-color: #8c7b54; border-radius: 0; color: #e5cfaa; padding: 8px 0; margin: 4px 0; font-size: 19px; }
.recorder-source-page .recorder-source-link:hover, .recorder-source-page .recorder-source-link:focus { color: #fff0ce; border-bottom-color: #efd19a; }
.recorder-source-disclosure { flex-shrink: 0; margin: 16px 0 0 0; }
.recorder-source-disclosure > .unity-toggle { min-height: 44px; font-size: 20px; color: #e5cfaa; }
.recorder-source-disclosure > .unity-foldout__content { margin-left: 0; }
.recorder-detail.recorder-sources-open { padding: 0; background-color: rgba(8, 11, 12, 0.65); border-width: 0; }
.recorder-sources-open .recorder-detail-navigation { padding: 0 0 24px 0; }
.recorder-sources-open .recorder-section { border-top-color: rgba(184, 193, 188, 0.18); }
.recorder-sources-open .recorder-fact { flex-direction: column; }
.recorder-sources-open .recorder-label { flex-basis: auto; margin-bottom: 4px; color: #d7be85; }
.recorder-sources-open .recorder-value, .recorder-sources-open .recorder-linked-value { flex-basis: auto; }
.recorder-loss-compact .recorder-source-navigation { width: 175px; margin-right: 24px; }
.recorder-loss-compact .recorder-source-title { font-size: 36px; }
.recorder-loss-compact .recorder-source-tab { font-size: 17px; padding: 8px; }
.recorder-loss-compact .recorder-source-heading { font-size: 29px; }
.recorder-loss-compact .recorder-source-description { font-size: 18px; }
.recorder-compact .recorder-source-layout { flex-direction: column; }
.recorder-compact .recorder-source-navigation { width: auto; flex-direction: row; flex-wrap: wrap; margin: 0 0 12px 0; }
.recorder-compact .recorder-source-title { width: 100%; margin-bottom: 8px; }
.recorder-compact .recorder-source-tab { margin: 0 8px 0 0; }
.recorder-contact .recorder-end-headline { font-size: 108px; }
.recorder-contact.recorder-loss-compact .recorder-end-headline { font-size: 78px; }
.recorder-contact.recorder-compact .recorder-end-card .recorder-end-headline { font-size: 52px; }

.recorder-sources-open .recorder-detail-navigation { padding-bottom: 8px; }
.recorder-source-page { padding-top: 0; }
.recorder-source-heading { font-size: 44px; }
.recorder-source-deck { margin-bottom: 20px; }
.recorder-source-description { font-size: 20px; margin-bottom: 10px; }
.recorder-source-note { font-size: 13px; margin-top: 12px; }
.recorder-source-page .recorder-source-link { border-width: 0; -unity-text-align: middle-left; padding: 5px 0; margin: 0; }
.recorder-source-disclosure { margin-top: 5px; }
.recorder-source-body { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.recorder-source-arrows { flex-direction: row; justify-content: center; flex-shrink: 0; height: 44px; }
.recorder-source-arrows .recorder-button { background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0 8px; padding: 0 12px; font-size: 26px; color: #d7be85; }
.recorder-source-arrows .recorder-button:disabled { opacity: 0.15; }
.recorder-source-arrows .recorder-button:hover, .recorder-source-arrows .recorder-button:focus { color: #ffffff; background-color: rgba(255, 255, 255, 0.06); }
.recorder-sources-open .recorder-detail-navigation { position: absolute; left: 0; bottom: 0; padding: 0; }
.recorder-sources-open #reportBackButton { border-width: 0; background-color: rgba(0, 0, 0, 0); padding: 8px 0; color: #c5c6c2; font-size: 18px; }
.recorder-sources-open #reportBackButton:hover, .recorder-sources-open #reportBackButton:focus { color: #edbc72; border-width: 0; }
.recorder-sources-open .recorder-source-layout { margin-top: 28px; margin-bottom: 56px; }
.recorder-sources-open #reportNasaPage { padding-top: 90px; }
.recorder-loss-compact .recorder-sources-open #reportNasaPage { padding-top: 40px; }

/* R40 Mission Record: same page language as Sources (no boxed panel, Barlow headings, title column, ESC Back bottom-left). */
.recorder-detail.recorder-record-open { padding: 0; background-color: rgba(8, 11, 12, 0.65); border-width: 0; }
.recorder-record-open .recorder-detail-navigation { position: absolute; left: 0; bottom: 0; padding: 0; }
.recorder-record-open .recorder-detail-title { display: none; }
.recorder-record-open #reportBackButton { border-width: 0; background-color: rgba(0, 0, 0, 0); padding: 8px 0; color: #c5c6c2; font-size: 18px; }
.recorder-record-open #reportBackButton:hover, .recorder-record-open #reportBackButton:focus { color: #edbc72; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.recorder-record-layout { flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; margin-top: 28px; margin-bottom: 56px; }
.recorder-record-navigation { width: 235px; flex-shrink: 0; margin-right: 42px; }
.recorder-record-title { font-size: 50px; letter-spacing: 2px; margin-bottom: 36px; white-space: normal; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-record-layout .recorder-roll-controls { flex-direction: column; align-items: stretch; padding-bottom: 0; border-bottom-width: 0; }
.recorder-record-layout .recorder-roll-caption { flex-grow: 0; margin: 0 0 14px 0; font-size: 13px; letter-spacing: 1.4px; color: #aeb5b2; }
.recorder-record-layout .recorder-roll-controls .recorder-button { -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); background-color: rgba(0, 0, 0, 0); color: #eee8dc; border-width: 0; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); border-radius: 0; margin: 0 0 14px 0; padding: 9px 12px; min-height: 44px; font-size: 21px; letter-spacing: 1px; -unity-text-align: middle-left; }
.recorder-record-layout .recorder-roll-controls .recorder-button:hover, .recorder-record-layout .recorder-roll-controls .recorder-button:focus { background-color: rgba(255, 255, 255, 0.04); border-width: 0; border-left-width: 2px; border-left-color: #efd19a; }
.recorder-record-layout .recorder-scroll { flex-basis: 0; }
.recorder-record-layout .recorder-summary { padding-top: 12px; padding-bottom: 28px; max-width: 820px; }
.recorder-record-status { font-size: 13px; letter-spacing: 2.5px; color: #d7be85; white-space: normal; margin-bottom: 10px; }
.recorder-lost .recorder-record-status { color: #e0675b; }
.recorder-recovery .recorder-record-status { color: #9fd4c8; }
.recorder-record-layout .recorder-headline { font-size: 44px; letter-spacing: 1px; margin-bottom: 8px; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-record-deck { font-size: 25px; color: #c5c6c2; white-space: normal; margin-bottom: 14px; }
.recorder-record-layout .recorder-reason { font-size: 20px; max-width: 720px; margin-bottom: 0; color: #eee8dc; }
.recorder-lost .recorder-record-layout .recorder-reason { border-left-width: 2px; border-left-color: #d85045; padding-left: 12px; }
.recorder-recovery .recorder-record-layout .recorder-reason { border-left-width: 2px; border-left-color: #7fbfb2; padding-left: 12px; }
.recorder-record-layout .recorder-elapsed { font-size: 13px; letter-spacing: 1.2px; color: #aeb5b2; margin-top: 14px; }
.recorder-record-layout .recorder-section { max-width: 900px; padding-top: 18px; padding-bottom: 22px; border-top-color: rgba(184, 193, 188, 0.18); }
.recorder-record-layout .recorder-section:focus { border-top-color: #d7be85; }
.recorder-record-layout .recorder-number { width: 40px; font-size: 22px; padding-top: 4px; color: #d7be85; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-record-layout .recorder-section-title { font-size: 30px; letter-spacing: 1px; -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/BarlowCondensed-Bold.ttf"); }
.recorder-record-layout .recorder-classification { font-size: 13px; letter-spacing: 1.6px; }
.recorder-record-layout .recorder-label { font-size: 18px; color: #aeb5b2; }
.recorder-record-layout .recorder-value { font-size: 20px; }
.recorder-record-layout .recorder-empty { font-size: 18px; }
.recorder-loss-compact .recorder-record-navigation { width: 175px; margin-right: 24px; }
.recorder-loss-compact .recorder-record-title { font-size: 36px; }
.recorder-loss-compact .recorder-record-layout .recorder-roll-controls .recorder-button { font-size: 17px; padding: 8px; }
.recorder-loss-compact .recorder-record-layout .recorder-headline { font-size: 36px; }
.recorder-compact .recorder-record-layout { flex-direction: column; margin-top: 12px; }
.recorder-compact .recorder-record-navigation { width: auto; margin: 0 0 12px 0; }
.recorder-compact .recorder-record-title { margin-bottom: 8px; }
.recorder-compact .recorder-record-layout .recorder-roll-controls { flex-direction: row; flex-wrap: wrap; align-items: center; }
.recorder-compact .recorder-record-layout .recorder-roll-caption { width: 100%; margin-bottom: 6px; }
.recorder-compact .recorder-record-layout .recorder-roll-controls .recorder-button { margin: 0 8px 0 0; }
.recorder-compact .recorder-record-layout .recorder-headline { font-size: 30px; }
.recorder-compact .recorder-record-deck { font-size: 20px; }
