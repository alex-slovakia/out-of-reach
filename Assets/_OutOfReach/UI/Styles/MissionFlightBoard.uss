.flight-board {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(242, 240, 233);
    -unity-font-definition: url("../Typography/SourceSans3-Regular.otf");
    -unity-font-style: normal;
    font-size: 16px;
}
.flight-board Label { margin: 0; padding: 0; }
.planner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.planner-heading { position: absolute; left: 48px; top: 58px; right: 500px; }
.title {
    font-size: 48px;
    letter-spacing: -1.4px;
    -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf");
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
    white-space: normal;
}
.intro {
    margin-top: 12px;
    color: rgb(216, 215, 210);
    font-size: 18px;
    white-space: normal;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9);
}
.payload-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 440px;
    padding: 34px 28px 28px;
    background-color: rgba(17, 19, 19, 0.94);
}
.payload-header { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 20px; }
.payload-title { font-size: 26px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.planning-timing { align-items: flex-end; margin-left: 12px; }
.deadline-countdown { color: rgb(210, 210, 201); font-size: 18px; }
.deadline-countdown.deadline-urgent { color: rgb(255, 110, 92); }
.constraints { flex-direction: row; flex-shrink: 0; padding-bottom: 16px; border-bottom-width: 1px; border-bottom-color: rgb(54, 55, 54); }
.constraint-row { flex-grow: 1; flex-basis: 0; min-width: 0; }
.constraint-row.power-constraint { flex-grow: 1.16; }
.constraint-label { font-size: 14px; color: rgb(170, 171, 167); }
.constraint-value { margin-top: 2px; font-size: 17px; }
.payload-scroll { flex-grow: 1; min-height: 0; margin-top: 10px; }
.payload-scroll .unity-scroll-view__content-container { padding-right: 0; }
.equipment-list { flex-shrink: 0; }
.equipment-row { min-height: 52px; flex-direction: row; align-items: center; flex-shrink: 0; }
.equipment-copy { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.equipment-name { font-size: 18px; }
.equipment-costs { margin-top: 0; color: rgb(190, 192, 182); font-size: 15px; white-space: normal; }
.equipment-row:hover .equipment-costs, .equipment-focused .equipment-costs { color: rgb(222, 221, 214); }
.stepper { flex-direction: row; align-items: center; flex-shrink: 0; }
.flight-board Button {
    color: rgb(242, 240, 233);
    background-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0);
    border-radius: 2px;
    margin: 0;
    font-size: 18px;
    -unity-font-definition: url("../Typography/SourceSans3-Regular.otf");
}
.flight-board Button:hover { background-color: rgb(53, 54, 52); }
.flight-board Button:focus { border-color: rgb(242, 240, 233); background-color: rgb(46, 47, 45); }
.flight-board Button:disabled { color: rgb(113, 115, 110); background-color: rgba(255, 255, 255, 0); }
.flight-board .quantity-button { width: 38px; height: 38px; padding: 0; background-color: rgb(37, 39, 37); font-size: 22px; }
.flight-board .quantity-button:hover { background-color: rgb(63, 65, 61); }
.flight-board .quantity-button:focus { border-color: rgb(242, 240, 233); }
.quantity-value { width: 32px; -unity-text-align: middle-center; font-size: 18px; }
.launch-details { flex-shrink: 0; margin: 12px 0 0; }
.launch-details > .unity-foldout__toggle { margin: 0; padding: 7px 0; min-height: 32px; font-size: 14px; color: rgb(204, 204, 197); border-width: 1px; border-color: rgba(255,255,255,0); border-radius: 5px; }
.launch-details > .unity-foldout__toggle:hover { color: rgb(242, 240, 233); background-color: rgb(36, 37, 35); }
.launch-details > .unity-foldout__toggle:focus { border-color: rgb(242, 240, 233); }
.launch-details .unity-foldout__content { margin-left: 0; padding-bottom: 12px; }
.launch-details .unity-toggle__text { font-size: 14px; }
.details-title { margin-top: 14px; margin-bottom: 8px; font-size: 16px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.planning-reserves { flex-direction: row; flex-wrap: wrap; }
.planning-reserves .resource-cell { width: 33.333%; padding: 0 8px 10px 0; }
.resource-label { font-size: 14px; color: rgb(177, 180, 175); }
.resource-value { font-size: 18px; margin-top: 1px; }
.small-note, .deadline-rule { color: rgb(177, 180, 175); white-space: normal; font-size: 14px; margin-top: 12px; }
.last-valid-counts { color: rgb(208, 209, 202); white-space: normal; font-size: 14px; }
.launch-review-actions { flex-shrink: 0; padding-top: 15px; }
.validation { color: rgb(196, 198, 189); font-size: 14px; white-space: normal; }
.command-feedback { margin-top: 5px; color: rgb(245, 181, 119); font-size: 14px; white-space: normal; }
.flight-board .launch-button { height: 48px; margin-top: 12px; color: rgb(23, 25, 23); background-color: rgb(240, 238, 229); border-radius: 2px; font-size: 18px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.flight-board .launch-button:hover { background-color: rgb(255, 254, 246); }
.flight-board .launch-button:focus { border-color: rgb(23, 25, 23); border-width: 3px; }
.flight-board .launch-button:disabled { color: rgb(125, 128, 119); background-color: rgb(47, 50, 45); }
.constraint-exceeded { color: rgb(245, 181, 119); }
.flight-board .unity-scroller { background-color: rgba(0, 0, 0, 0); }
.flight-board .unity-scroller--vertical { width: 6px; margin-left: 8px; }
.flight-board .unity-scroller__low-button, .flight-board .unity-scroller__high-button { display: none; }
.flight-board .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.03); border-width: 0; }
.flight-board .unity-base-slider__dragger { background-color: rgb(82, 85, 79); border-width: 0; border-radius: 3px; }
.flight-board .unity-base-slider__dragger:hover { background-color: rgb(145, 148, 138); }
.hud { position: absolute; left: 36px; top: 30px; right: 36px; bottom: 30px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95); }
.hud-header { position: absolute; left: 0; top: 0; max-width: 420px; }
.hud-phase { font-size: 19px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); white-space: normal; }
.hud-objective { color: rgb(214, 214, 205); font-size: 14px; margin-top: 3px; white-space: normal; }
.hud-timing { position: absolute; right: 0; top: 0; align-items: flex-end; }
.systems-timing { margin-top: 12px; padding-left: 28px; }
.elapsed-time { font-size: 14px; color: rgb(217, 218, 209); }
.simulation-timing { font-size: 13px; color: rgb(201, 204, 195); margin-top: 2px; }
.simulation-timing.timing-paused { color: rgb(245, 181, 119); }
.deadline-fallback { margin-top: 10px; color: rgb(245, 181, 119); font-size: 14px; white-space: normal; }
.outcome-reason { margin-top: 8px; font-size: 16px; white-space: normal; }
.hud-instruments { position: absolute; left: 0; bottom: 0; max-width: 430px; padding: 0; }
.primary-telemetry, .eva-telemetry, .expanded-telemetry { flex-direction: column; }
.expanded-telemetry { padding-top: 10px; }
.hud-readouts .resource-cell { width: 360px; min-height: 28px; flex-direction: row; align-items: center; flex-shrink: 0; }
.resource-icon { width: 20px; height: 20px; flex-shrink: 0; margin-right: 8px; }
.hud-readouts .resource-label { width: 92px; flex-shrink: 0; color: rgb(242, 240, 227); font-size: 14px; }
.hud-readouts .resource-value { display: none; font-size: 17px; color: rgb(248, 247, 239); margin: 0; white-space: nowrap; }
.flight-board .gauge-note { margin: 0 0 0 8px; color: rgb(240, 190, 126); font-size: 14px; white-space: nowrap; }
.gauge-bar { position: relative; width: 126px; height: 8px; min-height: 8px; max-height: 8px; margin: 0; padding: 0; flex-shrink: 0; }
.gauge-bar .unity-progress-bar__container { height: 8px; min-height: 8px; margin: 0; padding: 0; }
.gauge-bar .unity-progress-bar__background { height: 8px; min-height: 8px; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; }
.gauge-bar .unity-progress-bar__progress, .gauge-bar .unity-progress-bar__title-container, .gauge-bar .unity-progress-bar__title { display: none; }
.reserve-fill { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.gauge-critical .resource-label, .gauge-critical .resource-value, .gauge-critical .gauge-note { color: rgb(255, 137, 116); }
.gauge-unknown .gauge-note { color: rgb(222, 224, 213); }
.co2-alert { margin-top: 8px; }
.co2-alert .gauge-bar { display: none; }
.co2-alert .gauge-note { margin-left: 0; }
.suit-seal { font-size: 14px; margin-left: 12px; color: rgb(213, 216, 205); }
.flight-board .systems-button { align-self: flex-start; font-size: 14px; height: 28px; margin-top: 8px; margin-left: 24px; padding: 2px 4px; border-radius: 0; color: rgb(222, 224, 213); }
.flight-board .systems-button:hover, .flight-board .systems-button:focus, .flight-board .systems-button.systems-open { background-color: rgba(22, 23, 23, 0.86); }
.inspecting-systems { top: 80px; bottom: auto; padding: 14px 18px 12px 14px; background-color: rgba(13, 15, 15, 0.92); }
.inspecting-systems .resource-cell { width: 390px; }
.inspecting-systems .resource-label { width: 130px; }
.inspecting-systems .resource-value { display: flex; width: 108px; flex-shrink: 0; }
.inspecting-systems .gauge-bar { display: none; }
.inspecting-systems .eva-telemetry { margin-top: 8px; }
.inspecting-systems .eva-telemetry .resource-cell, .inspecting-systems .expanded-telemetry .resource-cell { padding-left: 28px; }
.inspecting-systems .suit-duration { flex-wrap: wrap; }
.inspecting-systems .suit-seal { margin-left: 0; }
.interaction-prompt { position: absolute; left: 50%; top: 54%; max-width: 440px; margin-left: 18px; flex-direction: row; align-items: center; }
.flight-board .interaction-key { flex-shrink: 0; font-size: 16px; width: 28px; height: 28px; color: rgb(23, 25, 23); -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); -unity-text-align: middle-center; background-color: rgb(240, 238, 229); margin-right: 10px; text-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.interaction-text { min-width: 0; flex-shrink: 1; white-space: normal; font-size: 18px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); padding: 4px 8px; background-color: rgba(13, 15, 15, 0.82); }
.subtitle-overlay { position: absolute; left: 18%; right: 18%; bottom: 9%; align-items: center; }
.survival-active .subtitle-overlay { left: 320px; right: 36px; bottom: 5%; }
.subtitle-box { max-width: 820px; padding: 4px 8px; background-color: rgba(0, 0, 0, 0); }
.subtitle-speaker { font-size: 12px; color: rgb(213, 215, 204); margin-bottom: 3px; -unity-text-align: middle-center; white-space: normal; }
.subtitle-text { font-size: 20px; color: rgb(247, 246, 240); -unity-text-align: middle-center; white-space: normal; text-shadow: 0 1px 1px rgba(0, 0, 0, 0.9); }
.interaction-prompt .interaction-text.constraint-exceeded { color: rgb(227, 228, 220); font-size: 16px; background-color: rgba(0, 0, 0, 0); }
.flight-board .is-hidden { display: none; }
.flight-board.report-visible .hud { display: none; }
.preflight { position: absolute; left: 36px; right: 36px; top: 30px; bottom: 30px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95); }
.preflight-objective { position: absolute; left: 0; top: 0; max-width: 430px; font-size: 19px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); white-space: normal; }
.preflight-timing { position: absolute; left: 35%; right: 35%; top: 0; align-items: center; }
.preflight-countdown { color: rgb(248, 247, 239); font-size: 44px; -unity-text-align: middle-center; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.preflight-countdown.deadline-practice { font-size: 18px; }
.preflight-countdown.deadline-urgent { color: rgb(255, 110, 92); }
.preflight-clock-note { font-size: 14px; color: rgb(235, 234, 222); margin-top: 0; -unity-text-align: middle-center; }
.preflight-loadout { position: absolute; left: 0; bottom: 0; }
.preflight-carried { font-size: 22px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.preflight-constraints { flex-direction: row; }
.preflight-constraints .constraint-label { color: rgb(218, 220, 210); font-size: 14px; }
.preflight-constraints .constraint-value { font-size: 18px; }
.preflight-validation { margin-top: 10px; font-size: 16px; white-space: normal; }
.preflight-details { position: absolute; left: 0; top: 65px; width: 560px; max-width: 48%; padding: 4px 18px 18px; background-color: rgba(13, 15, 15, 0.94); }
.preflight-details .details-title { font-size: 16px; }
.preflight-details .last-valid-counts { font-size: 14px; }
.preflight-detail-columns { flex-direction: row; }
.preflight-detail-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 14px; }
.preflight-reserves .resource-cell { flex-direction: row; justify-content: space-between; margin-bottom: 4px; }
.preflight-reserves .resource-value { font-size: 14px; margin: 0; }
.physical-planning .hud-header, .physical-planning .hud-timing, .physical-planning .hud-instruments { display: none; }
.departure-presentation .hud-header, .departure-presentation .hud-timing,
.departure-presentation .hud-instruments, .departure-presentation .interaction-prompt,
.departure-presentation .exertion-readout { display: none; }
.flight-board.menu-overlay-hidden { display: none; }
.session-controls { -unity-font-definition: url("../Typography/SourceSans3-Regular.otf"); color: rgb(242, 240, 233); }
.session-menu { justify-content: center; align-items: flex-start; padding-left: 7%; padding-right: 24px; text-shadow: 0 2px 5px rgba(0, 0, 0, 0.95); }
.session-menu-panel { width: 460px; max-width: 80%; }
.session-menu .session-menu-heading { font-size: 28px; color: rgb(242, 240, 233); -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); white-space: normal; margin: 0 0 28px; padding: 0; }
.session-menu .session-menu-action { height: 58px; margin: 0 0 8px; padding: 0 6px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); color: rgb(242, 240, 233); font-size: 30px; -unity-text-align: middle-left; -unity-font-definition: url("../Typography/SourceSans3-Regular.otf"); }
.session-menu .session-menu-primary { font-size: 36px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.session-menu .session-menu-action:hover { color: rgb(249, 201, 137); }
.session-menu .session-menu-action:focus { color: rgb(249, 201, 137); border-bottom-width: 1px; border-bottom-color: rgb(249, 201, 137); }
.session-menu .session-menu-action:active { color: rgb(255, 255, 247); }
.session-menu .session-menu-action:disabled { color: rgb(153, 158, 149); }
.session-menu .session-menu-action { transform-origin: left center; transition-property: scale, translate, color; transition-duration: 0.16s; transition-timing-function: ease-out; }
.session-menu .session-menu-action:hover, .session-menu .session-menu-action:focus { scale: 1.035 1.035; translate: 6px 0; }
.session-menu .session-menu-action:active { scale: 1.01 1.01; }
.session-menu.reduced-motion .session-menu-action { transition-duration: 0s; scale: 1 1; translate: 0 0; }
.session-menu .session-menu-detail { margin: 18px 0 0; padding: 0; font-size: 16px; color: rgb(233, 233, 221); white-space: normal; }
.session-menu .session-reduced { margin: 28px 0 0; padding: 0; min-height: 32px; font-size: 16px; color: rgb(242, 240, 233); white-space: normal; }
.session-reduced .unity-toggle__checkmark { width: 20px; height: 20px; margin-right: 10px; background-color: rgba(8, 10, 10, 0.6); border-width: 1px; border-color: rgb(218, 220, 210); }
.session-reduced:checked .unity-toggle__checkmark { background-color: rgb(240, 238, 229); -unity-background-image-tint-color: rgb(23, 25, 23); }
.session-reduced:focus .unity-toggle__checkmark { border-width: 2px; border-color: rgb(249, 201, 137); }
.session-menu .session-menu-controls { margin: 22px 0 0; padding: 0; font-size: 15px; color: rgb(222, 224, 213); white-space: normal; }
.session-menu .session-menu-feedback { margin: 14px 0 0; padding: 0; font-size: 16px; color: rgb(249, 201, 137); white-space: normal; }
.cargo-destination {
    position: absolute;
    width: 220px;
    align-items: center;
    color: rgb(242, 237, 221);
}
.cargo-destination-arrow {
    width: 12px;
    height: 12px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: rgb(242, 237, 221);
    border-bottom-color: rgb(242, 237, 221);
    margin-bottom: 12px;
}
.cargo-destination-caption {
    font-size: 18px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
.exertion-readout {
    position: absolute;
    right: 36px;
    bottom: 30px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
.exertion-readout .resource-cell { width: 254px; }
