.flight-board {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(242, 240, 233);
    -unity-font-definition: url("../Typography/SourceSans3-Regular.otf");
    -unity-font-style: normal;
    font-size: 16px;
}
.flight-board Label { margin: 0; padding: 0; }
.planner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.planner-heading { position: absolute; left: 48px; top: 58px; right: 500px; }
.title {
    font-size: 48px;
    letter-spacing: -1.4px;
    -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf");
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
    white-space: normal;
}
.intro {
    margin-top: 12px;
    color: rgb(216, 215, 210);
    font-size: 18px;
    white-space: normal;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9);
}
.payload-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 440px;
    padding: 34px 28px 28px;
    background-color: rgba(17, 19, 19, 0.94);
}
.payload-header { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; margin-bottom: 20px; }
.payload-title { font-size: 26px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.planning-timing { align-items: flex-end; margin-left: 12px; }
.deadline-countdown { color: rgb(190, 190, 185); font-size: 16px; }
.deadline-countdown.deadline-urgent { color: rgb(245, 181, 119); }
.constraints { flex-direction: row; flex-shrink: 0; padding-bottom: 16px; border-bottom-width: 1px; border-bottom-color: rgb(54, 55, 54); }
.constraint-row { flex-grow: 1; flex-basis: 0; min-width: 0; }
.constraint-row.power-constraint { flex-grow: 1.16; }
.constraint-label { font-size: 14px; color: rgb(170, 171, 167); }
.constraint-value { margin-top: 2px; font-size: 16px; }
.payload-scroll { flex-grow: 1; min-height: 0; margin-top: 10px; }
.payload-scroll .unity-scroll-view__content-container { padding-right: 0; }
.equipment-list { flex-shrink: 0; }
.equipment-row { min-height: 52px; flex-direction: row; align-items: center; flex-shrink: 0; }
.equipment-copy { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.equipment-name { font-size: 16px; }
.equipment-costs { margin-top: 0; color: rgb(166, 168, 164); font-size: 14px; white-space: normal; }
.equipment-row:hover .equipment-costs, .equipment-focused .equipment-costs { color: rgb(222, 221, 214); }
.stepper { flex-direction: row; align-items: center; flex-shrink: 0; }
.flight-board Button {
    color: rgb(242, 240, 233);
    background-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0);
    border-radius: 2px;
    margin: 0;
    font-size: 18px;
    -unity-font-definition: url("../Typography/SourceSans3-Regular.otf");
}
.flight-board Button:hover { background-color: rgb(53, 54, 52); }
.flight-board Button:focus { border-color: rgb(242, 240, 233); background-color: rgb(46, 47, 45); }
.flight-board Button:disabled { color: rgb(113, 115, 110); background-color: rgba(255, 255, 255, 0); }
.flight-board .quantity-button { width: 34px; height: 34px; padding: 0; background-color: rgb(37, 39, 37); font-size: 22px; }
.flight-board .quantity-button:hover { background-color: rgb(63, 65, 61); }
.flight-board .quantity-button:focus { border-color: rgb(242, 240, 233); }
.quantity-value { width: 30px; -unity-text-align: middle-center; font-size: 16px; }
.launch-details { flex-shrink: 0; margin: 12px 0 0; }
.launch-details > .unity-foldout__toggle { margin: 0; padding: 7px 0; min-height: 32px; font-size: 14px; color: rgb(204, 204, 197); border-width: 1px; border-color: rgba(255,255,255,0); border-radius: 5px; }
.launch-details > .unity-foldout__toggle:hover { color: rgb(242, 240, 233); background-color: rgb(36, 37, 35); }
.launch-details > .unity-foldout__toggle:focus { border-color: rgb(242, 240, 233); }
.launch-details .unity-foldout__content { margin-left: 0; padding-bottom: 12px; }
.launch-details .unity-toggle__text { font-size: 14px; }
.details-title { margin-top: 14px; margin-bottom: 8px; font-size: 16px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.planning-reserves { flex-direction: row; flex-wrap: wrap; }
.planning-reserves .resource-cell { width: 33.333%; padding: 0 8px 10px 0; }
.resource-label { font-size: 14px; color: rgb(177, 180, 175); }
.resource-value { font-size: 18px; margin-top: 1px; }
.small-note, .deadline-rule { color: rgb(177, 180, 175); white-space: normal; font-size: 14px; margin-top: 12px; }
.last-valid-counts { color: rgb(208, 209, 202); white-space: normal; font-size: 14px; }
.launch-review-actions { flex-shrink: 0; padding-top: 15px; }
.validation { color: rgb(196, 198, 189); font-size: 14px; white-space: normal; }
.command-feedback { margin-top: 5px; color: rgb(245, 181, 119); font-size: 14px; white-space: normal; }
.flight-board .launch-button { height: 46px; margin-top: 12px; color: rgb(23, 25, 23); background-color: rgb(240, 238, 229); border-radius: 2px; font-size: 17px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.flight-board .launch-button:hover { background-color: rgb(255, 254, 246); }
.flight-board .launch-button:focus { border-color: rgb(23, 25, 23); border-width: 3px; }
.flight-board .launch-button:disabled { color: rgb(125, 128, 119); background-color: rgb(47, 50, 45); }
.constraint-exceeded { color: rgb(245, 181, 119); }
.flight-board .unity-scroller { background-color: rgba(0, 0, 0, 0); }
.flight-board .unity-scroller--vertical { width: 6px; margin-left: 8px; }
.flight-board .unity-scroller__low-button, .flight-board .unity-scroller__high-button { display: none; }
.flight-board .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.03); border-width: 0; }
.flight-board .unity-base-slider__dragger { background-color: rgb(82, 85, 79); border-width: 0; border-radius: 3px; }
.flight-board .unity-base-slider__dragger:hover { background-color: rgb(145, 148, 138); }
.hud { position: absolute; left: 36px; top: 30px; right: 36px; bottom: 30px; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95); }
.hud-header { position: absolute; left: 0; top: 0; max-width: 420px; }
.hud-phase { font-size: 19px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); white-space: normal; }
.hud-objective { color: rgb(214, 214, 205); font-size: 14px; margin-top: 3px; white-space: normal; }
.hud-timing { position: absolute; right: 0; top: 0; align-items: flex-end; }
.elapsed-time { font-size: 14px; color: rgb(217, 218, 209); }
.simulation-timing { font-size: 13px; color: rgb(201, 204, 195); margin-top: 2px; }
.simulation-timing.timing-paused { color: rgb(245, 181, 119); }
.deadline-fallback { margin-top: 10px; color: rgb(245, 181, 119); font-size: 14px; white-space: normal; }
.outcome-reason { margin-top: 8px; font-size: 16px; white-space: normal; }
.hud-instruments { position: absolute; left: 0; bottom: 0; max-width: 420px; padding: 0; }
.primary-telemetry, .eva-telemetry, .expanded-telemetry { flex-direction: row; }
.expanded-telemetry { padding-top: 14px; }
.hud-readouts .resource-cell { width: 126px; flex-shrink: 0; margin-right: 18px; }
.hud-readouts .resource-label { color: rgb(218, 220, 210); font-size: 13px; }
.hud-readouts .resource-value { font-size: 22px; color: rgb(248, 247, 239); -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); margin-top: 0; white-space: nowrap; }
.flight-board .gauge-note { margin-top: 5px; color: rgb(232, 185, 123); font-size: 12px; white-space: normal; }
.gauge-bar { height: 3px; min-height: 3px; max-height: 3px; margin: 6px 0 0; padding: 0; }
.gauge-bar .unity-progress-bar__container { height: 3px; min-height: 3px; margin: 0; padding: 0; }
.gauge-bar .unity-progress-bar__background { height: 3px; min-height: 3px; padding: 0; background-color: rgba(238, 235, 220, 0.24); border-width: 0; border-radius: 0; margin: 0; }
.gauge-bar .unity-progress-bar__progress { height: 3px; min-height: 3px; padding: 0; background-color: rgb(220, 222, 210); border-width: 0; border-radius: 0; margin: 0; }
.gauge-bar .unity-progress-bar__title-container, .gauge-bar .unity-progress-bar__title { display: none; }
.gauge-unknown .unity-progress-bar__background { background-color: rgba(238, 235, 220, 0.15); }
.gauge-low .unity-progress-bar__progress { background-color: rgb(230, 170, 94); }
.gauge-critical .unity-progress-bar__progress { background-color: rgb(224, 111, 92); }
.gauge-critical .resource-value, .gauge-critical .gauge-note { color: rgb(255, 155, 132); }
.suit-seal { font-size: 12px; margin-top: 3px; color: rgb(213, 216, 205); }
.flight-board .systems-button { align-self: flex-start; font-size: 12px; height: 24px; margin-top: 10px; margin-left: -4px; padding: 2px 4px; border-radius: 0; color: rgb(206, 210, 199); }
.flight-board .systems-button:hover, .flight-board .systems-button:focus, .flight-board .systems-button.systems-open { background-color: rgba(22, 23, 23, 0.86); }
.inspecting-systems { top: 80px; bottom: auto; padding: 16px 4px 10px 16px; background-color: rgba(13, 15, 15, 0.92); }
.inspecting-systems .resource-cell { width: 112px; margin-right: 16px; }
.inspecting-systems .eva-telemetry { margin-top: 16px; }
.interaction-prompt { position: absolute; left: 50%; top: 54%; max-width: 350px; margin-left: 18px; flex-direction: row; align-items: center; }
.flight-board .interaction-key { flex-shrink: 0; font-size: 13px; width: 22px; height: 22px; border-width: 1px; border-color: rgba(242, 240, 233, 0.7); -unity-text-align: middle-center; background-color: rgba(13, 15, 15, 0.75); margin-right: 8px; }
.interaction-text { white-space: normal; font-size: 15px; padding: 3px 6px; background-color: rgba(13, 15, 15, 0.72); }
.subtitle-overlay { position: absolute; left: 24%; right: 24%; bottom: 18%; align-items: center; }
.subtitle-box { max-width: 760px; padding: 8px 14px 10px; background-color: rgba(8, 9, 8, 0.76); }
.subtitle-speaker { font-size: 12px; color: rgb(213, 215, 204); margin-bottom: 3px; -unity-text-align: middle-center; white-space: normal; }
.subtitle-text { font-size: 18px; color: rgb(255, 254, 247); -unity-text-align: middle-center; white-space: normal; text-shadow: 0 1px 2px rgba(0, 0, 0, 1); }
.flight-board .is-hidden { display: none; }
.flight-board.report-visible .hud { display: none; }
