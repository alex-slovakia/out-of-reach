.flight-board {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(231, 228, 217);
    font-size: 16px;
}
Label { margin: 0; padding: 0; }
.planner {
    flex-grow: 1;
    background-color: rgba(15, 22, 27, 0.98);
    padding: 24px 32px 20px 32px;
}
.planner-heading { flex-shrink: 0; margin-bottom: 16px; }
.eyebrow { color: rgb(148, 188, 197); font-size: 16px; }
.title { font-size: 32px; margin-top: 4px; margin-bottom: 4px; -unity-font-style: bold; }
.intro { color: rgb(185, 192, 190); white-space: normal; }
.planning-timing { margin-top: 12px; padding-left: 12px; border-left-width: 2px; border-left-color: rgb(92, 115, 122); }
.deadline-countdown { color: rgb(155, 208, 216); font-size: 20px; -unity-font-style: bold; }
.deadline-countdown.deadline-urgent { color: rgb(230, 184, 115); }
.deadline-rule { margin-top: 4px; color: rgb(202, 199, 186); white-space: normal; }
.planner-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.equipment-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 30px; }
.section-heading { padding-bottom: 12px; color: rgb(202, 199, 186); border-bottom-width: 1px; border-bottom-color: rgb(66, 78, 83); }
.equipment-list { flex-grow: 1; min-height: 0; }
.equipment-list .unity-scroll-view__content-container { padding-right: 12px; }
.flight-board .unity-scroller { background-color: rgb(15, 22, 27); }
.flight-board .unity-scroller--vertical { width: 12px; margin-left: 6px; }
.flight-board .unity-scroller__low-button,
.flight-board .unity-scroller__high-button { display: none; }
.flight-board .unity-base-slider__tracker { background-color: rgb(36, 50, 56); border-width: 0; }
.flight-board .unity-base-slider__dragger { background-color: rgb(92, 115, 122); border-width: 0; border-radius: 0; }
.flight-board .unity-base-slider__dragger:hover { background-color: rgb(147, 180, 188); }
.equipment-row { flex-direction: row; align-items: center; padding: 13px 0; border-bottom-width: 1px; border-bottom-color: rgb(48, 61, 67); flex-shrink: 0; }
.equipment-copy { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 16px; }
.equipment-name { font-size: 18px; -unity-font-style: bold; }
.equipment-description { margin-top: 3px; color: rgb(189, 194, 192); white-space: normal; }
.equipment-costs { margin-top: 7px; color: rgb(147, 180, 188); white-space: normal; }
.stepper { flex-direction: row; align-items: center; flex-shrink: 0; }
.flight-board Button {
    color: rgb(231, 228, 217);
    background-color: rgb(31, 43, 50);
    border-width: 1px;
    border-color: rgb(92, 115, 122);
    border-radius: 0;
    margin: 0;
    font-size: 18px;
}
.flight-board Button:hover { background-color: rgb(44, 61, 68); }
.flight-board Button:focus { border-color: rgb(157, 210, 219); border-width: 2px; }
.flight-board Button:disabled { opacity: 0.45; }
.quantity-button { width: 40px; height: 40px; padding: 0; }
.quantity-value { min-width: 35px; -unity-text-align: middle-center; font-size: 18px; }
.overview { width: 350px; flex-shrink: 0; min-height: 0; }
.overview-scroll { flex-grow: 1; min-height: 0; }
.overview .unity-scroll-view__content-container { padding-right: 10px; }
.launch-review-actions { flex-shrink: 0; padding-top: 10px; border-top-width: 1px; border-top-color: rgb(66, 78, 83); }
.constraint-row { margin-top: 12px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgb(48, 61, 67); }
.constraint-label { color: rgb(185, 192, 190); }
.constraint-value { font-size: 22px; color: rgb(155, 208, 216); margin-top: 4px; }
.constraint-exceeded { color: rgb(230, 184, 115); }
.reserves-heading { margin-top: 18px; margin-bottom: 8px; color: rgb(202, 199, 186); }
.planning-reserves { flex-direction: row; flex-wrap: wrap; }
.planning-reserves .resource-cell { width: 50%; padding: 6px 8px 8px 0; }
.resource-label { font-size: 16px; color: rgb(185, 192, 190); }
.resource-value { font-size: 22px; color: rgb(155, 208, 216); margin-top: 3px; }
.small-note { color: rgb(175, 185, 185); white-space: normal; margin-top: 8px; }
.last-valid-detail { margin-top: 8px; padding-bottom: 14px; border-top-width: 1px; border-top-color: rgb(48, 61, 67); }
.last-valid-counts { color: rgb(202, 199, 186); white-space: normal; }
.validation { margin-top: 4px; white-space: normal; }
.command-feedback { margin-top: 8px; color: rgb(230, 184, 115); white-space: normal; }
.flight-board .launch-button { height: 48px; margin-top: 16px; -unity-font-style: bold; }
.planner-footer { flex-shrink: 0; flex-direction: row; justify-content: space-between; margin-top: 18px; padding-top: 12px; border-top-width: 1px; border-top-color: rgb(66, 78, 83); }
.footer-label { color: rgb(147, 180, 188); }
.footer-note { color: rgb(175, 185, 185); margin-left: 20px; white-space: normal; }
.hud { position: absolute; left: 24px; top: 24px; right: 24px; bottom: 24px; }
.hud-header { align-self: flex-start; flex-direction: row; align-items: center; padding: 12px 16px; background-color: rgba(15, 22, 27, 0.9); border-top-width: 1px; border-top-color: rgb(92, 115, 122); }
.simulation-timing { margin-left: 24px; color: rgb(155, 208, 216); -unity-font-style: bold; white-space: normal; }
.simulation-timing.timing-paused { color: rgb(230, 184, 115); }
.deadline-fallback { align-self: flex-start; max-width: 600px; margin-top: 8px; padding: 8px 12px; color: rgb(230, 184, 115); background-color: rgba(15, 22, 27, 0.95); white-space: normal; }
.hud-vessel { -unity-font-style: bold; margin-right: 24px; }
.hud-phase { color: rgb(185, 204, 207); }
.hud-phase.constraint-exceeded { color: rgb(230, 184, 115); }
.hud-instruments { position: absolute; left: 0; right: 0; bottom: 0; padding: 12px 16px; background-color: rgba(15, 22, 27, 0.9); border-top-width: 1px; border-top-color: rgb(92, 115, 122); }
.hud-strip-title { color: rgb(185, 192, 190); margin-bottom: 10px; }
.hud-readouts { flex-direction: row; }
.hud-readouts .resource-cell { flex-grow: 1; flex-basis: 0; min-width: 0; border-left-width: 1px; border-left-color: rgb(65, 80, 86); padding-left: 14px; }
.hud-note { margin-top: 10px; color: rgb(175, 185, 185); }
.outcome-reason { align-self: flex-start; max-width: 560px; margin-top: 8px; color: rgb(230, 184, 115); white-space: normal; background-color: rgba(15, 22, 27, 0.9); }
.subtitle-overlay { position: absolute; left: 40px; right: 40px; bottom: 180px; align-items: center; }
.subtitle-box { width: 80%; max-width: 900px; padding: 12px 20px; background-color: rgba(10, 16, 20, 0.96); border-top-width: 1px; border-top-color: rgb(92, 115, 122); }
.subtitle-speaker { font-size: 16px; color: rgb(155, 208, 216); margin-bottom: 5px; -unity-text-align: middle-center; white-space: normal; }
.subtitle-text { font-size: 22px; color: rgb(242, 238, 224); -unity-text-align: middle-center; white-space: normal; }
