.survival-needs { margin-top: 4px; }
.survival-need-row { width: 360px; min-height: 28px; flex-direction: row; align-items: center; color: rgb(242, 240, 227); }
.survival-need-icon { width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }
.survival-need-label { width: 92px; font-size: 14px; flex-shrink: 0; }
.survival-need-bar { width: 126px; height: 6px; min-height: 6px; margin: 0; padding: 0; flex-shrink: 0; }
.survival-need-bar .unity-progress-bar__container { height: 6px; min-height: 6px; margin: 0; padding: 0; }
.survival-need-bar .unity-progress-bar__background { height: 6px; min-height: 6px; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgba(220, 222, 212, 0.17); }
.survival-need-bar .unity-progress-bar__progress { height: 6px; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: rgb(242, 240, 227); }
.survival-need-bar .unity-progress-bar__title-container { display: none; }
.survival-need-row.survival-attention { color: rgb(245, 188, 116); }
.survival-attention .unity-progress-bar__progress { background-color: rgb(245, 188, 116); }
.survival-need-row.survival-critical { color: rgb(255, 137, 116); }
.survival-critical .unity-progress-bar__progress { background-color: rgb(255, 137, 116); }
.survival-unknown { opacity: 0.45; }
.survival-rest { position: absolute; left: 0; right: 0; bottom: 16%; align-items: center; color: rgb(242, 240, 227); }
.survival-rest-day { font-size: 22px; letter-spacing: 2px; margin-bottom: 5px; }
.survival-rest-time { font-size: 14px; margin-bottom: 10px; }
.survival-rest .survival-wake { min-width: 86px; height: 30px; margin: 0; padding: 3px 18px; font-size: 14px; border-radius: 0; border-width: 1px; border-color: rgba(242, 240, 227, 0.5); background-color: rgba(15, 17, 17, 0.65); color: rgb(242, 240, 227); }
.survival-rest .survival-wake:hover, .survival-rest .survival-wake:focus { border-color: rgb(245, 188, 116); background-color: rgba(25, 28, 27, 0.9); }
.survival-rest .survival-wake:disabled { opacity: 0.45; }
.survival-rest-feedback { max-width: 330px; font-size: 13px; margin-top: 7px; white-space: normal; -unity-text-align: middle-center; }
.survival-recovery-detail { margin-top: 10px; max-width: 362px; }
.survival-recovery-title { font-size: 14px; color: rgb(242, 240, 227); }
.survival-recovery-line { font-size: 13px; color: rgb(214, 217, 208); white-space: normal; margin-top: 3px; }
.survival-recovery-note { font-size: 12px; color: rgb(177, 184, 177); white-space: normal; margin-top: 6px; }
.survival-hidden { display: none; }

.survival-needs-key { display: none; font-size: 11px; color: rgb(177, 184, 177); margin-top: 3px; white-space: normal; }
.inspecting-systems .survival-needs-key { display: flex; }
.survival-alerts { max-width: 420px; }
.survival-need-guidance { font-size: 14px; color: rgb(207, 220, 218); margin-top: 9px; white-space: normal; }
.survival-need-guidance.survival-need-urgent { color: rgb(245, 188, 116); -unity-font: url("project://database/Assets/_OutOfReach/UI/Typography/SourceSans3-Semibold.otf"); }
.survival-need-guidance.survival-need-critical { color: rgb(255, 137, 116); font-size: 16px; }
.survival-beacon-action { font-size: 15px; color: rgb(245, 188, 116); margin-top: 9px; white-space: normal; }
.survival-beacon-window { font-size: 13px; color: rgb(245, 188, 116); margin-top: 3px; white-space: normal; }
.survival-rest-stop { font-size: 14px; color: rgb(242, 240, 227); margin-top: 9px; white-space: normal; }
.survival-presentation-layer, .survival-rest-eyes, .survival-water-locator { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.survival-presentation-layer { -unity-font-definition: url("../Typography/SourceSans3-Regular.otf"); }
.survival-water-distance { position: absolute; width: 170px; font-size: 13px; letter-spacing: 1px; color: rgb(155, 229, 232); white-space: normal; -unity-text-align: upper-center; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95); }
.survival-presentation-layer .survival-rest { bottom: 16%; }
.survival-presentation-layer .survival-rest-day { font-size: 28px; letter-spacing: 4px; -unity-font-definition: url("../Typography/SourceSans3-Semibold.otf"); }
.survival-presentation-layer .survival-rest-time { color: rgb(180, 191, 190); margin-bottom: 18px; }
.survival-presentation-layer .survival-wake { min-width: 104px; height: 40px; font-size: 16px; border-color: rgba(207, 220, 216, 0.45); }
