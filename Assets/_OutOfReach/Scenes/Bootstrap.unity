  - {fileID: 1324593848}
  - {fileID: 522837786}
  planningFramingPivot: {fileID: 835283663}
  planningViewAnchor: {fileID: 393375177}
  powerStatusLight: {fileID: 1372898505}
  lifeSupportStatusLight: {fileID: 1178081058}
  recordedBriefing:
    cueId: vo01_mc_briefing
    cleanClip: {fileID: 8300000, guid: c86bf0824ffd12a4faa14d0dfb8fcbe0, type: 3}
    subtitleText: 'Aurora Seven, Mission Control. Your research plan is approved.
      Check your systems and reserve margins. We''ll be listening.

'
  impactWarning:
    cueId: vo02_ship_impact
    cleanClip: {fileID: 8300000, guid: 82296db9ac1542b7be47d55e5ccb39b4, type: 3}
    subtitleText: 'Power fault. Life support degraded. Communications offline. Check
      engineering diagnostics.

'
  houstonDistress:
    cueId: houston_to_earth
    cleanClip: {fileID: 8300000, guid: 52641712ba754a3590c9dd98cab507aa, type: 3}
    subtitleText: 'Mission Control, this is Houston aboard Aurora Seven. We''re drifting
      off course. Do you copy? Please respond.

'
  powerRestored:
    cueId: vo03_ship_power_restored
    cleanClip: {fileID: 8300000, guid: 15abb20fd15c0684abc36d1b74cc6e3f, type: 3}
    subtitleText: 'Power system restored. Review remaining faults and reserve levels.

'
  lifeSupportRestored:
    cueId: vo04_ship_life_support_restored
    cleanClip: {fileID: 8300000, guid: 817665d67f940ca419bb7f4448148553, type: 3}
    subtitleText: 'Life support restored. Stored oxygen and cabin carbon dioxide
      remain under observation. Check your reserves.

'
  antennaRestored:
    cueId: vo07_ship_antenna_restored
    cleanClip: {fileID: 8300000, guid: 1d43376166d50564cbfd248f94bfdde3, type: 3}
    subtitleText: 'Antenna repair confirmed. Return to the communications console
      to prepare your transmission.

'
  falseSignal:
    cueId: vo09_ship_buffer_diagnosis
    cleanClip: {fileID: 8300000, guid: d6fe8faf4c80afe47880c9af8c4d4136, type: 3}
    subtitleText: 'Playback source identified. Local outgoing buffer. This is our
      earlier recording. No Earth reply has been received.

'
  transmissionSent:
    cueId: vo10_ship_transmission_sent
    cleanClip: {fileID: 8300000, guid: e1e5cd001a78cb448ac5489bab3c15c9, type: 3}
    subtitleText: 'Distress transmission sent. Awaiting Earth reply. Estimated remaining
      time is shown on the communications display.

'
  earthReply:
    cueId: vo11_mc_reply_received
    cleanClip: {fileID: 8300000, guid: 44f2fa12c778414b8b595d7cf1bf14f0, type: 3}
    subtitleText: 'Aurora Seven, we received your position. We''re assessing recovery
      options. Conserve power and life support. Rescue is not yet confirmed.

'
  outerHatchOpen:
    cueId: vo06_ship_eva_exit
    cleanClip: {fileID: 8300000, guid: 65c057e36bf956649a9d74bc6319e5fd, type: 3}
    subtitleText: 'Outer hatch open. Follow the marked tether route. Monitor your
      suit reserves and return through this airlock.

'
