* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.shader text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.csv text eol=lf
*.py text eol=lf

# Preserve the byte-exact NASA response used by the provenance SHA-256.
/docs/data/horizons/*.raw.json -text

# Binary source assets. Keep Unity YAML and .meta GUIDs as reviewable text.
